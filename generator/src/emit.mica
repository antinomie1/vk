// Registry -> one Mica module: constants, types and `extern table`s of
// commands (one per core version and level, one per extension and level).

import std.str
import std.collections.map
import registry
import names
import types

struct Cx {
    /// FlagBits enum -> its Flags type (C names)
    owner: map.Map[str, str]
    /// enum value (C name) -> `Type.VARIANT`
    variant: map.Map[str, str]
    missing: List[str]
}

pub fn emit(r: registry.Registry) -> Result[str, str] {
    var owner: map.Map[str, str] = map.Map.new()
    for td in r.types {
        if td.cat == "bitmask" and td.alias.is_empty() and not td.base.is_empty() {
            discard owner.insert(td.base.clone(), td.name.clone())
        }
    }
    var cx = Cx { owner, variant: map.Map.new(), missing: [] }
    let live = r.live(false)
    var enums = ""
    var items = ""
    // Enums first: struct defaults name their values.
    for pass in 0..2 {
        for i, td in r.types {
            let is_enum = td.alias.is_empty() and (td.cat == "enum" or td.cat == "bitmask")
            if live[i] and is_enum == (pass == 0) {
                type_item(r, mut cx, td, mut enums, mut items)
            }
        }
    }
    var out = prologue(r)
    out += constants(r)
    out += enums
    out += items
    out += tables(r)
    guard cx.missing.is_empty() else {
        return Err("unmapped types: " + str.join(cx.missing, ", "))
    }
    return Ok(out.trim_end() + "\n")
}

fn prologue(r: registry.Registry) -> str {
    var out = """
        //! Low-level Vulkan bindings, generated by `generator` from vk.xml and
        //! video.xml; do not edit.
        //!
        //! Types drop the `Vk` prefix (`VkResult` keeps it); enum and flag
        //! values drop the type prefix (`Format.R8G8B8A8_UNORM`,
        //! `BufferUsageFlags.TRANSFER_SRC`); commands live in `extern table`s:
        //! `StaticFn` (`vkGetInstanceProcAddr`), `EntryFnV1_0`, `InstanceFnV1_0`,
        //! `DeviceFnV1_0`, ... and `KhrSwapchainDeviceFn`, ... per extension;
        //! commands an extension has only with another version or extension
        //! are in their own table (`KhrSwapchainV1_1DeviceFn`).

        import std.collections.map

        /// The Vulkan loader of this platform, for `StaticFn.open`.
        when os == "windows" \{
            pub let loader_name = "vulkan-1.dll"
        \} else when os == "macos" \{
            pub let loader_name = "libvulkan.1.dylib"
        \} else \{
            pub let loader_name = "libvulkan.so.1"
        \}

        pub fn make_api_version(variant: u32, major: u32, minor: u32, patch: u32) -> u32 \{
            return (variant << 29) | (major << 22) | (minor << 12) | patch
        \}

        pub fn api_version_variant(version: u32) -> u32 \{
            return version >> 29
        \}

        pub fn api_version_major(version: u32) -> u32 \{
            return (version >> 22) & 0x7F
        \}

        pub fn api_version_minor(version: u32) -> u32 \{
            return (version >> 12) & 0x3FF
        \}

        pub fn api_version_patch(version: u32) -> u32 \{
            return version & 0xFFF
        \}

        /// `SUCCESS` is `Ok`; every other code, including positive ones such
        /// as `INCOMPLETE`, is `Err`: `try fns.create_device(...).result()`.
        pub fn VkResult.result(self) -> Result[(), VkResult] \{
            return if self == VkResult.SUCCESS \{ Ok(()) \} else \{ Err(self) \}
        \}

        pub let header_version: u32 = {r.header_version}

        """
    var last = 0
    for v in r.versions {
        let p = v.split("_")
        let major = p[0].to_int().unwrap_or(0)
        let minor = p[1].to_int().unwrap_or(0)
        last = (major << 22) | (minor << 12)
        out += "pub let api_version_{v}: u32 = {last}\n"
    }
    out += "pub let header_version_complete: u32 = {last | r.header_version}\n\n"
    return out
}

fn constants(r: registry.Registry) -> str {
    var out = ""
    for c in r.consts {
        let ty = if c.ty.is_empty() { "" } else { ": " + c.ty }
        out += "pub let {names.constant(c.name)}{ty} = {c.value}\n"
    }
    return out + "\n"
}

fn type_item(r: registry.Registry, mut cx: Cx, td: registry.TypeDef, mut enums: str, mut out: str) {
    let name = names.type_name(td.name)
    if not td.alias.is_empty() {
        out += "pub type {name} = {names.type_name(td.alias)}\n\n"
        return
    }
    match td.cat {
        "external" => {
            let t = types.external(td.name)
            if t.is_empty() {
                cx.missing.push(td.name.clone())
            }
            out += "pub type {name} = {t}\n\n"
        }
        "basetype" => out += "pub type {name} = {types.basetype(td)}\n\n"
        "handle" => {
            let raw = if td.flag { "usize" } else { "u64" }
            out += "pub struct {name} derive(Show, Hash) \{\n    pub raw: {raw} = 0\n\}\n\n"
        }
        "enum" => {
            if let Some(f) = cx.owner.get(td.name) {
                out += "pub type {name} = {names.type_name(f)}\n\n"
            } else if types.is_flag_bits(r, td.name) {
                enums += enum_item(r, mut cx, td.name, td.name, true, false)
            } else {
                enums += enum_item(r, mut cx, td.name, td.name, false, false)
            }
        }
        "bitmask" => enums += enum_item(r, mut cx, td.name, td.base, true, td.flag)
        "funcpointer" => {
            var ps: List[str] = []
            for p in td.members {
                ps.push(types.field(r, p))
            }
            let args = str.join(ps, ", ")
            out += "pub type {name} = extern fn({args}){ret(r, td.ret)}\n\n"
        }
        "struct" or "union" => out += struct_item(r, mut cx, td)
        _ => {}
    }
}

/// `pub enum Name: i32 { ... }`, or for a bitmask `Name: u32 derive(Flags)`
/// with the values of its `FlagBits` enum `bits`.
fn enum_item(r: registry.Registry, mut cx: Cx, c_name: str, bits: str, bitmask: bool, wide: bool) -> str {
    let name = names.type_name(c_name)
    var body = ""
    var big = wide
    var seen: List[str] = []
    if let Some(ei) = r.enum_ix.get(bits) {
        for v in r.enums[ei].vals {
            var vn = names.variant(bits, v.name, bitmask, r.tags)
            if seen.contains(vn) {
                vn = v.name.strip_prefix("VK_").unwrap_or(v.name.clone())
            }
            seen.push(vn.clone())
            discard cx.variant.insert(v.name.clone(), "{name}.{vn}")
            if v.value.len() > 10 {
                big = true
            }
            body += "    {vn} = {v.value}\n"
        }
    }
    let repr = if not bitmask { "i32 derive(Show, Hash)" } else if big { "u64 derive(Flags, Show, Hash)" } else { "u32 derive(Flags, Show, Hash)" }
    guard not body.is_empty() else {
        return "pub enum {name}: {repr} \{\}\n\n"
    }
    return "pub enum {name}: {repr} \{\n{body}\}\n\n"
}

fn struct_item(r: registry.Registry, mut cx: Cx, td: registry.TypeDef) -> str {
    let name = names.type_name(td.name)
    if td.cat == "union" {
        var body = ""
        for m in td.members {
            body += "    pub {names.snake(m.name)}: {types.field(r, m)}\n"
        }
        return "extern union {name} \{\n{body}\}\n\n"
    }
    let w = types.bits_width(r, td)
    if w > 0 {
        return "pub struct {name} bits(u{w}) \{\n{bit_fields(td.members, 0, td.members.len())}\}\n\n"
    }
    var unsafe_ = false
    var body = ""
    var extra = ""
    var run = 0
    var i = 0
    let n = td.members.len()
    while i < n {
        let m = td.members[i].clone()
        if m.bits > 0 {
            let unit = types.unit_bits(m.ty)
            var used = 0
            var j = i
            while j < n and td.members[j].bits > 0 and types.unit_bits(td.members[j].ty) == unit and used + td.members[j].bits <= unit {
                used += td.members[j].bits
                j += 1
            }
            let bn = "{name}Bits{run}"
            extra += "pub struct {bn} bits(u{unit}) \{\n{bit_fields(td.members, i, j)}\}\n\n"
            var fname = "bits{run}"
            if j - i <= 2 {
                var parts: List[str] = []
                for k in i..j {
                    parts.push(names.snake(td.members[k].name))
                }
                fname = str.join(parts, "_and_")
            }
            body += "    pub {fname}: {bn} = {bn} \{ bits: 0 \}\n"
            run += 1
            i = j
            continue
        }
        if types.has_ptr(r, m) {
            unsafe_ = true
        }
        body += "    pub {names.snake(m.name)}: {types.field(r, m)} = {default(r, mut cx, m)}\n"
        i += 1
    }
    let u = if unsafe_ { "unsafe " } else { "" }
    return "pub {u}struct {name} \{\n{body}\}\n\n" + extra
}

fn bit_fields(ms: List[registry.Member], lo: int, hi: int) -> str {
    var out = ""
    for k in lo..hi {
        let t = if ms[k].bits == 1 { "bool" } else { "u{ms[k].bits}" }
        out += "    pub {names.snake(ms[k].name)}: {t}\n"
    }
    return out
}

/// The zero value of a field (its `values` for `sType`).
fn default(r: registry.Registry, mut cx: Cx, m: registry.Member) -> str {
    guard m.dims.is_empty() else {
        return "zeroed()"
    }
    guard m.ptrs == 0 else {
        return "Ptr.null()"
    }
    let k = types.kind(r, m.ty)
    let i = r.resolve(m.ty)
    let canon = if i >= 0 { canonical(r, cx, i) } else { "" }
    return match k {
        "int" => "0"
        "float" => "0.0"
        "ptr" => "Ptr.null()"
        "fnptr" => "None"
        "handle" or "struct" => canon + " \{\}"
        "bits" => canon + " \{ bits: 0 \}"
        "union" => "zeroed()"
        "enum" => match cx.variant.get(m.values) {
            Some(v) => v
            None => canon + "(0)"
        }
        "flags" => canon + "(0)"
        _ => {
            cx.missing.push(m.ty.clone())
            "0"
        }
    }
}

/// Emitted name of type `i`: a `FlagBits` enum is its Flags type.
fn canonical(r: registry.Registry, cx: Cx, i: int) -> str {
    let c = r.types[i].name.clone()
    return match cx.owner.get(c) {
        Some(f) => names.type_name(f)
        None => names.type_name(c)
    }
}

/// ` -> T` of a return type, "" for `void`.
fn ret(r: registry.Registry, m: registry.Member) -> str {
    guard not (m.ty == "void" and m.ptrs == 0) else {
        return ""
    }
    return " -> " + types.field(r, m)
}

/// A command parameter: `const char*` strings are `str`; required
/// single-object outputs are `mut` (a C pointer to the caller's value).
fn param(r: registry.Registry, m: registry.Member) -> str {
    let name = names.snake(m.name)
    if m.ptrs == 1 and m.ty == "char" and m.is_const and m.len.starts_with("null-terminated") and not m.optional {
        return "{name}: str"
    }
    let opaque = m.ptrs == 1 and types.kind(r, m.ty) == "opaque"
    if m.ptrs > 0 and not m.is_const and not m.optional and m.len.is_empty() and not opaque {
        return "mut {name}: {types.wrap(r, m, m.ptrs - 1)}"
    }
    return "{name}: {types.field(r, m)}"
}

/// Dispatch level of a command: entry, instance or device.
fn level(r: registry.Registry, c: registry.Command) -> str {
    if c.params.is_empty() {
        return "entry"
    }
    if c.name == "vkGetDeviceProcAddr" {
        return "instance"
    }
    let i = r.resolve(c.params[0].ty)
    let first = if i >= 0 { r.types[i].name.clone() } else { "" }
    return match first {
        "VkInstance" or "VkPhysicalDevice" => "instance"
        "VkDevice" or "VkQueue" or "VkCommandBuffer" => "device"
        _ => "entry"
    }
}

fn tables(r: registry.Registry) -> str {
    var out = "extern table StaticFn \{\n    fn get_instance_proc_addr(instance: Instance, p_name: str) -> Option[PFN_vkVoidFunction] = \"vkGetInstanceProcAddr\"\n\}\n\n"
    for g in r.groups {
        var entry = ""
        var inst = ""
        var dev = ""
        for cn in g.commands {
            guard cn != "vkGetInstanceProcAddr" else {
                continue
            }
            guard let Some(ci) = r.cmd_ix.get(cn) else {
                continue
            }
            let c = r.command_of(ci)
            var ps: List[str] = []
            for p in c.params {
                ps.push(param(r, p))
            }
            let args = str.join(ps, ", ")
            let line = "    fn {names.command(c.name)}({args}){ret(r, c.ret)} = \"{c.name}\"\n"
            match level(r, c) {
                "entry" => entry += line
                "instance" => inst += line
                _ => dev += line
            }
        }
        if g.ext {
            out += table("{g.name}InstanceFn", entry + inst)
            out += table("{g.name}DeviceFn", dev)
        } else {
            out += table("EntryFn{g.name}", entry)
            out += table("InstanceFn{g.name}", inst)
            out += table("DeviceFn{g.name}", dev)
        }
    }
    return out
}

fn table(name: str, body: str) -> str {
    guard not body.is_empty() else {
        return ""
    }
    return "extern table {name} \{\n{body}\}\n\n"
}
