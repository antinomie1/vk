// The vk bundle's layout test: `tests/layout.c` prints, and
// `tests/layout.mica` computes, one line per struct and union of
// `vulkan_core.h` / `vulkan_beta.h` and the Video Std headers: size,
// alignment and the offset of every member outside a bit field.

import registry
import names
import types

/// (`layout.c`, `layout.mica`).
pub fn emit(r: registry.Registry) -> (str, str) {
    var c = """
        // Generated by `generator`; do not edit. The C side of layout.mica.
        #define VK_ENABLE_BETA_EXTENSIONS
        #include <stddef.h>
        #include <stdio.h>
        #include <vulkan/vulkan.h>

        int main(void) \{

        """
    var m = """
        // Generated by `generator`; do not edit. Compiles layout.c against
        // the system's Vulkan headers and compares its output with the Mica
        // layout of every struct and union; skipped without `cc` or headers.

        import std.io
        import std.fs
        import std.process
        import vk

        test "struct layout matches the C headers" \{
            let dir = fs.create_temp_dir("vk-layout").expect("temp dir")
            defer \{
                discard fs.remove_dir_all(dir)
            \}
            discard fs.write(dir + "/layout.c", embed("layout.c")).expect("write layout.c")
            let built = process.output("cc", [dir + "/layout.c", "-o", dir + "/layout"])
            guard built.is_ok() and built.unwrap().status == 0 else \{
                io.eprint("layout: skipped (no cc or Vulkan headers)")
                return
            \}
            let got = process.output(dir + "/layout", []).expect("run layout").stdout.lines()
            let want = rows()
            assert_eq(got.len(), want.len())
            for i, w in want \{
                assert_eq(got[i], w)
            \}
        \}

        fn rows() -> List[str] \{
            return [

        """
    let live = r.live(true)
    for i, td in r.types {
        guard live[i] and td.alias.is_empty() and (td.cat == "struct" or td.cat == "union") else {
            continue
        }
        let name = names.type_name(td.name)
        let t = "vk." + name
        var cfmt = name + " %zu %zu"
        var cargs = "sizeof({td.name}), _Alignof({td.name})"
        var row = name + " \{size_of[{t}]()\} \{align_of[{t}]()\}"
        if td.cat == "struct" and types.bits_width(r, td) == 0 {
            for f in td.members {
                if f.bits == 0 {
                    cfmt += " %zu"
                    cargs += ", offsetof({td.name}, {f.name})"
                    row += " \{offset_of[{t}]({names.snake(f.name)})\}"
                }
            }
        }
        c += "    printf(\"{cfmt}\\n\", {cargs});\n"
        m += "        \"{row}\",\n"
    }
    c += "    return 0;\n\}\n"
    m += "    ]\n\}\n"
    return (c, m)
}
