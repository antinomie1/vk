// Generated by `generator`; do not edit. Compiles layout.c against
// the system's Vulkan headers and compares its output with the Mica
// layout of every struct and union; skipped without `cc` or headers.

import std.io
import std.fs
import std.process
import vk

test "struct layout matches the C headers" {
    let dir = fs.create_temp_dir("vk-layout").expect("temp dir")
    defer {
        discard fs.remove_dir_all(dir)
    }
    discard fs.write(dir + "/layout.c", embed("layout.c")).expect("write layout.c")
    let built = process.output("cc", [dir + "/layout.c", "-o", dir + "/layout"])
    guard built.is_ok() and built.unwrap().status == 0 else {
        io.eprint("layout: skipped (no cc or Vulkan headers)")
        return
    }
    let got = process.output(dir + "/layout", []).expect("run layout").stdout.lines()
    let want = rows()
    assert_eq(got.len(), want.len())
    for i, w in want {
        assert_eq(got[i], w)
    }
}

