// Values, derives and the system loader (skipped when no Vulkan loader or
// driver is installed). Struct layout is checked by layout.mica.

import std.collections.map
import vk

test "values" {
    assert_eq(vk.api_version_minor(vk.api_version_1_3), 3)
    assert_eq(i32(vk.StructureType.APPLICATION_INFO), 0)
    assert_eq(i32(vk.VkResult.ERROR_OUT_OF_DATE_KHR), -1000001004)
    assert_eq(i32(vk.ImageType.TYPE_2D), 1)
    let u = vk.BufferUsageFlags.TRANSFER_SRC | vk.BufferUsageFlags.VERTEX_BUFFER
    assert_eq(u.bits(), 0x81)
    assert(u.contains(vk.BufferUsageFlags.TRANSFER_SRC))
    assert_eq(vk.PipelineStageFlags2.ALL_COMMANDS.bits(), u64(0x10000))
    let info = vk.BufferCreateInfo {}
    assert(info.s_type == vk.StructureType.BUFFER_CREATE_INFO)
}

test "derives and result" {
    var seen: map.Map[vk.Buffer, int] = map.Map.new()
    discard seen.insert(vk.Buffer { raw: 7 }, 1)
    assert_eq(seen.get(vk.Buffer { raw: 7 }), Some(1))
    assert(seen.get(vk.Buffer {}).is_none())
    assert_eq("{vk.Format.R8G8B8A8_UNORM}", "R8G8B8A8_UNORM")
    assert(vk.VkResult.SUCCESS.result().is_ok())
    assert_eq(vk.VkResult.INCOMPLETE.result(), Err(vk.VkResult.INCOMPLETE))
}

test "instance and device" {
    guard let Ok(st) = vk.StaticFn.open(vk.loader_name) else {
        return
    }
    let entry = vk.EntryFnV1_0.load(fn(n) => st.get_instance_proc_addr(vk.Instance {}, n))
    let name = "vk-test"
    unsafe let app = vk.ApplicationInfo { p_application_name: name.as_cstr(), api_version: vk.api_version_1_1 }
    unsafe let info = vk.InstanceCreateInfo { p_application_info: Ptr.of(app) }
    var inst = vk.Instance {}
    unsafe let r = entry.create_instance(Ptr.of(info), Ptr.null(), mut inst)
    guard r == vk.VkResult.SUCCESS else {
        return
    }
    let fns = vk.InstanceFnV1_0.load(fn(n) => st.get_instance_proc_addr(inst, n))
    var count: u32 = 0
    assert(fns.enumerate_physical_devices(inst, mut count, Ptr.null()) == vk.VkResult.SUCCESS)
    var devs: List[vk.PhysicalDevice] = []
    for _ in 0..count {
        devs.push(vk.PhysicalDevice {})
    }
    assert(fns.enumerate_physical_devices(inst, mut count, devs) == vk.VkResult.SUCCESS)
    if count > 0 {
        var props = vk.PhysicalDeviceProperties {}
        fns.get_physical_device_properties(devs[0], mut props)
        assert_eq(vk.api_version_major(props.api_version), 1)
        assert(props.device_name[0] != 0)

        var prio: f32 = 1.0
        unsafe let queue = vk.DeviceQueueCreateInfo { queue_count: 1, p_queue_priorities: Ptr.of(prio) }
        let ext_name = vk.khr_swapchain_extension_name
        unsafe let exts: [1]Ptr[u8] = [ext_name.as_cstr()]
        unsafe let dinfo = vk.DeviceCreateInfo {
            queue_create_info_count: 1,
            p_queue_create_infos: Ptr.of(queue),
            enabled_extension_count: 1,
            pp_enabled_extension_names: Ptr.of(exts).cast[Ptr[u8]](),
        }
        var dev = vk.Device {}
        unsafe let rd = fns.create_device(devs[0], Ptr.of(dinfo), Ptr.null(), mut dev)
        assert(rd.result().is_ok())
        let dfns = vk.DeviceFnV1_0.load(fn(n) => fns.get_device_proc_addr(dev, n))
        // The base swapchain table loads without its `depends` commands.
        assert(vk.KhrSwapchainDeviceFn.try_load(fn(n) => fns.get_device_proc_addr(dev, n)).is_some())
        var q = vk.Queue {}
        dfns.get_device_queue(dev, 0, 0, mut q)
        assert(q.raw != 0)
        assert(dfns.queue_wait_idle(q) == vk.VkResult.SUCCESS)
        dfns.destroy_device(dev, Ptr.null())
    }
    fns.destroy_instance(inst, Ptr.null())
}
