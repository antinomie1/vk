// The graph on the real device: a pass nothing reads is culled, the rest
// run in order, and transient textures come back from the pool.

import vk_gpu as gpu
import vk_graph as graph

test "culling, order and pooling" {
    guard let Ok(d) = gpu.Device.open(gpu.Options { headless: true, validation: true }) else {
        return
    }
    var dev = d
    let p = dev.graphics(gpu.Graphics { color: gpu.Format.R8G8B8A8_UNORM }, embed("../../vk_gpu/tests/shaders/fullscreen.vert.spv"), embed("../../vk_gpu/tests/shaders/sample.frag.spv")).unwrap()
    let out = dev.texture(gpu.TextureDesc { width: 4, height: 4, target: true }).unwrap()
    let desc = gpu.TextureDesc { width: 4, height: 4, target: true }
    var g = graph.Graph.new()
    let none: List[gpu.Texture] = []
    var first: u32 = 0
    for frame in 0..2 {
        let a = g.texture(mut dev, desc).unwrap()
        let unused = g.texture(mut dev, desc).unwrap()
        if frame == 0 {
            first = a.index()
        }
        assert_eq(a.index(), first)
        g.render(gpu.Pass { target: a, clear: [1.0, 0.0, 0.0, 1.0] }, none, Box(fn(mut r: gpu.Render) {}))
        let src = a.index()
        g.render(gpu.Pass { target: out }, [a], Box(fn(mut r: gpu.Render) {
            r.bind(p)
            r.push(bytes_of(src))
            r.draw(3, 1)
        }))
        g.render(gpu.Pass { target: unused, clear: [0.0, 0.0, 1.0, 1.0] }, none, Box(fn(mut r: gpu.Render) {}))
        var e = dev.encoder().unwrap()
        g.run(mut dev, mut e, [out])
        assert_eq(g.ran(), 2)
        discard dev.submit(take e).unwrap()
    }
    assert_eq(g.pooled(), 2)
    let px = dev.read_texture(out).unwrap()
    assert_eq((px[0], px[1], px[2], px[3]), (u8(255), u8(0), u8(0), u8(255)))
    for _ in 0..5 {
        var e = dev.encoder().unwrap()
        g.run(mut dev, mut e, [out])
        discard dev.submit(take e).unwrap()
    }
    assert_eq(g.pooled(), 0)
}
