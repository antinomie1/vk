// Axis-aligned rectangles in pixels: shapes, clips and damage.

@derive(Show)
pub struct Rect {
    pub x: f32 = 0.0
    pub y: f32 = 0.0
    pub w: f32 = 0.0
    pub h: f32 = 0.0
}

pub fn Rect.is_empty(self) -> bool {
    return self.w <= 0.0 or self.h <= 0.0
}

/// The smallest rectangle holding both (an empty one adds nothing).
pub fn Rect.union(self, o: Rect) -> Rect {
    guard not self.is_empty() else {
        return o
    }
    guard not o.is_empty() else {
        return self
    }
    let x = min(self.x, o.x)
    let y = min(self.y, o.y)
    return Rect { x, y, w: max(self.x + self.w, o.x + o.w) - x, h: max(self.y + self.h, o.y + o.h) - y }
}

/// The overlap; empty when there is none.
pub fn Rect.intersect(self, o: Rect) -> Rect {
    let x = max(self.x, o.x)
    let y = max(self.y, o.y)
    let w = min(self.x + self.w, o.x + o.w) - x
    let h = min(self.y + self.h, o.y + o.h) - y
    guard w > 0.0 and h > 0.0 else {
        return Rect {}
    }
    return Rect { x, y, w, h }
}

pub fn Rect.overlaps(self, o: Rect) -> bool {
    return not self.intersect(o).is_empty()
}

/// Grown by `d` on every side.
pub fn Rect.grow(self, d: f32) -> Rect {
    return Rect { x: self.x - d, y: self.y - d, w: self.w + 2.0 * d, h: self.h + 2.0 * d }
}

/// Whether `o` lies inside (an empty `o` is inside anything that is not empty).
pub fn Rect.contains(self, o: Rect) -> bool {
    return not self.is_empty() and o.x >= self.x and o.y >= self.y and o.x + o.w <= self.x + self.w and o.y + o.h <= self.y + self.h
}

/// The smallest whole-pixel rectangle holding it.
pub fn Rect.outer(self) -> Rect {
    let x = self.x.floor()
    let y = self.y.floor()
    return Rect { x, y, w: (self.x + self.w).ceil() - x, h: (self.y + self.h).ceil() - y }
}

/// The largest whole-pixel rectangle inside it; empty when there is none.
pub fn Rect.inner(self) -> Rect {
    let x = self.x.ceil()
    let y = self.y.ceil()
    let w = (self.x + self.w).floor() - x
    let h = (self.y + self.h).floor() - y
    guard w > 0.0 and h > 0.0 else {
        return Rect {}
    }
    return Rect { x, y, w, h }
}

pub fn Rect.area(self) -> f32 {
    return if self.is_empty() { 0.0 } else { self.w * self.h }
}
