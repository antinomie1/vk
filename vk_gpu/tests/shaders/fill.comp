#version 460
#extension GL_EXT_buffer_reference : require

// words[i] = i * 3 for i < count, through a buffer device address.
layout(local_size_x = 64) in;
layout(buffer_reference, std430) buffer Words { uint v[]; };
layout(push_constant) uniform P { Words words; uint count; } p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < p.count) {
        p.words.v[i] = i * 3u;
    }
}
