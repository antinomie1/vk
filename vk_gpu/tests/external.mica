// Sharing on the real device: a texture exported as a dmabuf, drawn into,
// fenced with a sync_file, then imported as another texture and sampled.
// Skipped when the driver lacks the dmabuf or sync_file extensions.

import std.io
import std.os
import vk_gpu as gpu

test "dmabuf and sync_file round trip" {
    guard let Ok(d) = gpu.Device.open(gpu.Options { headless: true, validation: true }) else {
        return
    }
    var dev = d
    let exported = dev.export_dmabuf(gpu.TextureDesc { width: 4, height: 4 })
    guard let Ok((a, buf)) = exported else {
        io.eprint("skipped: {exported.unwrap_err()}")
        return
    }
    assert(buf.fd >= 0)
    assert(buf.stride >= 16)
    var e = dev.encoder().unwrap()
    e.render(gpu.Pass { target: a, clear: [0.0, 1.0, 0.0, 1.0] }, fn(mut r) {})
    let (t, fence) = dev.submit_sync_file(take e).unwrap()

    let b = dev.import_dmabuf(buf).unwrap()
    assert(b.imported())
    dev.wait_sync_file(fence).unwrap()
    let dst = dev.texture(gpu.TextureDesc { width: 4, height: 4, target: true }).unwrap()
    let p = dev.graphics(gpu.Graphics { color: gpu.Format.R8G8B8A8_UNORM }, embed("shaders/fullscreen.vert.spv"), embed("shaders/sample.frag.spv")).unwrap()
    var e2 = dev.encoder().unwrap()
    e2.acquire(b)
    let index = b.index()
    e2.render(gpu.Pass { target: dst }, fn(mut r) {
        r.bind(p)
        r.push(bytes_of(index))
        r.draw(3, 1)
    })
    e2.release(b)
    dev.wait(dev.submit(take e2).unwrap()).unwrap()
    assert(dev.done(t))
    let px = dev.read_texture(dst).unwrap()
    for i in 0..16 {
        assert_eq((px[i * 4], px[i * 4 + 1], px[i * 4 + 2], px[i * 4 + 3]), (u8(0), u8(255), u8(0), u8(255)))
    }
}

test "offscreen frames report their age" {
    guard let Ok(d) = gpu.Device.open(gpu.Options { headless: true }) else {
        return
    }
    var dev = d
    var out = gpu.Offscreen.create(mut dev, 2, 2, gpu.Format.R8G8B8A8_UNORM).unwrap()
    for want in [u32(0), u32(1), u32(1)] {
        let f = out.acquire(mut dev).unwrap().unwrap()
        assert_eq(f.age(), want)
        var e = dev.encoder().unwrap()
        e.render(gpu.Pass { target: f.image() }, fn(mut r) {})
        discard out.present(mut dev, f, take e).unwrap()
    }
    out.resize(3, 3)
    assert_eq(out.acquire(mut dev).unwrap().unwrap().age(), u32(0))
}

test "modifiers, exports with a modifier list, and custom frames" {
    guard let Ok(d) = gpu.Device.open(gpu.Options { headless: true, validation: true }) else {
        return
    }
    var dev = d
    let sampled = dev.dmabuf_modifiers(gpu.Format.B8G8R8A8_UNORM, false)
    let rendered = dev.dmabuf_modifiers(gpu.Format.B8G8R8A8_UNORM, true)
    guard not rendered.is_empty() else {
        io.eprint("skipped: no dmabuf modifiers")
        return
    }
    assert(sampled.len() >= rendered.len())
    for m in rendered {
        assert(sampled.contains(m))
    }
    if let Some((major, minor)) = dev.drm_node() {
        assert(major > 0 and minor >= 0)
    }
    // The driver picks one of the offered layouts.
    let (t, buf) = dev.export_dmabuf_with(gpu.TextureDesc { width: 8, height: 8, format: gpu.Format.B8G8R8A8_UNORM }, rendered).unwrap()
    assert(rendered.contains(buf.modifier))
    // A frame of a target outside vk_gpu, drawn and fenced.
    let f = gpu.Frame.new(t, 0)
    var e = dev.encoder().unwrap()
    e.render(gpu.Pass { target: f.image(), clear: [1.0, 0.0, 0.0, 1.0] }, fn(mut r) {})
    let (ticket, fence) = dev.submit_sync_file(take e).unwrap()
    assert(fence >= -1)
    dev.wait(ticket).unwrap()
    let none: List[u64] = []
    assert(dev.export_dmabuf_with(gpu.TextureDesc { width: 8, height: 8 }, none).is_err())
}

fn dup_dmabuf(b: gpu.Dmabuf) -> gpu.Dmabuf {
    let n = b.plane_count()
    var planes: [4]gpu.Plane = [gpu.Plane {}, gpu.Plane {}, gpu.Plane {}, gpu.Plane {}]
    for i in 0..n {
        let p = b.plane(i)
        planes[i] = gpu.Plane { fd: i32(os.dup(int(p.fd)).unwrap()), offset: p.offset, stride: p.stride }
    }
    return gpu.Dmabuf {
        fd: planes[0].fd,
        width: b.width,
        height: b.height,
        format: b.format,
        modifier: b.modifier,
        offset: planes[0].offset,
        stride: planes[0].stride,
        opaque: b.opaque,
        num_planes: n,
        planes,
    }
}

test "writable dmabuf target and copy_texture" {
    guard let Ok(d) = gpu.Device.open(gpu.Options { headless: true, validation: true }) else {
        return
    }
    var dev = d
    let cap_mods = dev.dmabuf_capture_modifiers(gpu.Format.B8G8R8A8_UNORM)
    guard not cap_mods.is_empty() else {
        return
    }
    let exported = dev.export_dmabuf_with(gpu.TextureDesc { width: 4, height: 4, format: gpu.Format.B8G8R8A8_UNORM }, cap_mods)
    guard let Ok((view_tex, cap_buf)) = exported else {
        return
    }
    let dup_buf = dup_dmabuf(cap_buf)
    let cap_dst = dev.import_dmabuf_target(dup_buf).unwrap()
    let src = dev.texture(gpu.TextureDesc { width: 4, height: 4, format: gpu.Format.B8G8R8A8_UNORM, target: true }).unwrap()
    var e = dev.encoder().unwrap()
    e.render(gpu.Pass { target: src, clear: [1.0, 0.25, 0.5, 1.0] }, fn(mut r) {})
    e.acquire(cap_dst)
    e.copy_texture(src, cap_dst, 0, 0, 0, 0, 4, 4)
    if cap_dst.can_target() {
        e.render(gpu.Pass { target: cap_dst, load: gpu.Load.Keep }, fn(mut r) {})
    }
    e.release(cap_dst)
    let (_, fence) = dev.submit_sync_file(take e).unwrap()
    dev.destroy_texture(cap_dst)

    // Sample the captured buffer through a fresh import to verify GPU copy completed.
    let sampled = dev.import_dmabuf(cap_buf).unwrap()
    dev.wait_sync_file(fence).unwrap()
    let dst = dev.texture(gpu.TextureDesc { width: 4, height: 4, format: gpu.Format.B8G8R8A8_UNORM, target: true }).unwrap()
    let p = dev.graphics(gpu.Graphics { color: gpu.Format.B8G8R8A8_UNORM }, embed("shaders/fullscreen.vert.spv"), embed("shaders/sample.frag.spv")).unwrap()
    var e2 = dev.encoder().unwrap()
    e2.acquire(sampled)
    let index = sampled.index()
    e2.render(gpu.Pass { target: dst }, fn(mut r) {
        r.bind(p)
        r.push(bytes_of(index))
        r.draw(3, 1)
    })
    e2.release(sampled)
    dev.wait(dev.submit(take e2).unwrap()).unwrap()
    let px = dev.read_texture(dst).unwrap()
    // B8G8R8A8_UNORM for rgba(1.0, 0.25, 0.5, 1.0) is ~(128, 64, 255, 255)
    assert(px[0] > 120 and px[0] < 135 and px[1] > 58 and px[1] < 70 and px[2] == 255 and px[3] == 255)
    dev.destroy_texture(view_tex)
    dev.destroy_texture(src)
    dev.destroy_texture(sampled)
    dev.destroy_texture(dst)
    dev.destroy_pipeline(p)
}

test "multi-plane dmabuf export and import round trip" {
    guard let Ok(d) = gpu.Device.open(gpu.Options { headless: true, validation: true }) else {
        return
    }
    var dev = d
    let mods = dev.dmabuf_modifiers(gpu.Format.B8G8R8A8_UNORM, true)
    var multi: List[u64] = []
    for m in mods {
        if let Ok((t, b)) = dev.export_dmabuf_with(gpu.TextureDesc { width: 8, height: 8, format: gpu.Format.B8G8R8A8_UNORM }, [m]) {
            let n = b.plane_count()
            dev.destroy_texture(t)
            if n > 1 {
                for i in 0..n {
                    os.close(int(b.plane(i).fd))
                }
                multi.push(m)
                break
            }
            for i in 0..n {
                os.close(int(b.plane(i).fd))
            }
        }
    }
    guard not multi.is_empty() else {
        io.eprint("skipped: no multi-plane render modifier")
        return
    }
    let (src, buf) = dev.export_dmabuf_with(gpu.TextureDesc { width: 8, height: 8, format: gpu.Format.B8G8R8A8_UNORM }, multi).unwrap()
    assert(buf.plane_count() > 1)
    var e = dev.encoder().unwrap()
    e.render(gpu.Pass { target: src, clear: [0.0, 1.0, 0.0, 1.0] }, fn(mut r) {})
    let (_, fence) = dev.submit_sync_file(take e).unwrap()

    let tex = dev.import_dmabuf(buf).unwrap()
    dev.wait_sync_file(fence).unwrap()
    let dst = dev.texture(gpu.TextureDesc { width: 8, height: 8, format: gpu.Format.B8G8R8A8_UNORM, target: true }).unwrap()
    let p = dev.graphics(gpu.Graphics { color: gpu.Format.B8G8R8A8_UNORM }, embed("shaders/fullscreen.vert.spv"), embed("shaders/sample.frag.spv")).unwrap()
    var e2 = dev.encoder().unwrap()
    e2.acquire(tex)
    let index = tex.index()
    e2.render(gpu.Pass { target: dst }, fn(mut r) {
        r.bind(p)
        r.push(bytes_of(index))
        r.draw(3, 1)
    })
    e2.release(tex)
    dev.wait(dev.submit(take e2).unwrap()).unwrap()
    let px = dev.read_texture(dst).unwrap()
    assert_eq((px[0], px[1], px[2], px[3]), (u8(0), u8(255), u8(0), u8(255)))
    dev.destroy_texture(tex)
    dev.destroy_texture(src)
    dev.destroy_texture(dst)
    dev.destroy_pipeline(p)
}

test "queue global priority opens and falls back cleanly" {
    guard let Ok(dev) = gpu.Device.open(gpu.Options { headless: true, validation: true, priority: gpu.Priority.Realtime }) else {
        return
    }
    let p = dev.priority().as_i32()
    assert(p == 0 or p == 256 or p == 512 or p == 1024)
}

test "failed dmabuf import leaves caller fds untouched" {
    guard let Ok(d) = gpu.Device.open(gpu.Options { headless: true, validation: true }) else {
        return
    }
    var dev = d
    guard let Ok((src, buf)) = dev.export_dmabuf(gpu.TextureDesc { width: 4, height: 4 }) else {
        return
    }
    let bad = gpu.Dmabuf { modifier: 0x0011223344556677, ..buf }
    assert(dev.import_dmabuf(bad).is_err())
    // Caller still owns buf.fd: duplicating and then importing validly must succeed.
    let fd_check = os.dup(int(buf.fd))
    assert(fd_check.is_ok())
    os.close(fd_check.unwrap())
    let ok_tex = dev.import_dmabuf(buf).unwrap()
    dev.destroy_texture(ok_tex)
    dev.destroy_texture(src)
}

test "device lost rejects work and drops cleanly" {
    guard let Ok(d) = gpu.Device.open(gpu.Options { headless: true }) else {
        return
    }
    var dev = d
    let e = dev.encoder().unwrap()
    let t = dev.submit(take e).unwrap()
    dev.mark_lost()
    assert(dev.lost())
    assert(dev.done(t))
    assert(dev.encoder().is_err())
    assert(dev.wait(t).is_err())
}
