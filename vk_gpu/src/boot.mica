// Instance and device creation. Vulkan 1.3 is the floor: dynamic
// rendering, synchronization2, timeline semaphores, buffer device address
// and update-after-bind descriptor indexing are required, so nothing above
// this file needs render passes, fences or per-draw descriptor sets.

import vk
import ctx
import bindless
import device

/// Window-system tables, present when their extensions are enabled.
struct Wsi {
    surf: Option[vk.KhrSurfaceInstanceFn]
    /// Platform surface extensions enabled on the instance.
    platforms: List[str]
    swapchain: Option[vk.KhrSwapchainDeviceFn]
}

/// Sharing tables (dmabuf, sync_file), present when their extensions are.
struct External {
    mem_fd: Option[vk.KhrExternalMemoryFdDeviceFn] = None
    sem_fd: Option[vk.KhrExternalSemaphoreFdDeviceFn] = None
    drm: Option[vk.ExtImageDrmFormatModifierDeviceFn] = None
    dmabuf: bool = false
}

struct Base {
    cx: ctx.Ctx
    wsi: Wsi
    ext: External
    bl: bindless.Bindless
    max_textures: u32
    max_groups: [3]u32
    mem_props: vk.PhysicalDeviceMemoryProperties
    /// The DRM node (major, minor) of the device, render node preferred.
    drm_node: Option[(i64, i64)]
    priority: device.Priority = device.Priority.Default
}

/// The physical device to use and the queue family that draws and computes.
struct Pick {
    pdev: vk.PhysicalDevice
    family: u32
    score: int
}

fn named(a: [256]u8, name: str) -> bool {
    guard name.len() < 256 else {
        return false
    }
    for i in 0..name.len() {
        if a[i] != name[i] {
            return false
        }
    }
    return a[name.len()] == 0
}

fn has_ext(props: List[vk.ExtensionProperties], name: str) -> bool {
    return props.any(fn(p) => named(p.extension_name, name))
}

unsafe fn cstrs(names: Slice[str]) -> List[Ptr[u8]] {
    var out: List[Ptr[u8]] = []
    for s in names {
        out.push(s.as_cstr())
    }
    return out
}

fn supported_priorities(inst: ctx.Inst, pd: vk.PhysicalDevice, family: u32) -> List[i32] {
    var out: List[i32] = []
    var count: u32 = 0
    inst.get_physical_device_queue_family_properties2(pd, mut count, Ptr.null())
    guard int(family) < int(count) else {
        return out
    }
    var qprops: List[vk.QueueFamilyProperties2] = []
    var gprops: List[vk.QueueFamilyGlobalPriorityProperties] = []
    for _ in 0..int(count) {
        gprops.push(vk.QueueFamilyGlobalPriorityProperties {})
    }
    unsafe {
        let gbase = gprops.as_ptr().cast[vk.QueueFamilyGlobalPriorityProperties]()
        for i in 0..int(count) {
            qprops.push(vk.QueueFamilyProperties2 { p_next: gbase.offset(i).cast[u8]() })
        }
    }
    unsafe inst.get_physical_device_queue_family_properties2(pd, mut count, qprops.as_ptr())
    let gp = gprops[int(family)]
    for i in 0..int(gp.priority_count) {
        out.push(i32(gp.priorities[i]))
    }
    return out
}

fn priority_candidates(want: device.Priority) -> List[device.Priority] {
    return match want {
        Realtime => [device.Priority.Realtime, device.Priority.High, device.Priority.Medium]
        High => [device.Priority.High, device.Priority.Medium]
        Medium => [device.Priority.Medium]
        Low => [device.Priority.Low]
        Default => []
    }
}

fn create(st: vk.StaticFn, o: device.Options) -> Result[Base, str] {
    let entry = vk.EntryFnV1_0.load(fn(n) => st.get_instance_proc_addr(vk.Instance {}, n))
    var n: u32 = 0
    discard entry.enumerate_instance_extension_properties(Ptr.null(), mut n, Ptr.null())
    var iexts: List[vk.ExtensionProperties] = []
    for _ in 0..n {
        iexts.push(vk.ExtensionProperties {})
    }
    discard entry.enumerate_instance_extension_properties(Ptr.null(), mut n, iexts)
    var enable: List[str] = []
    let want_surface = not o.headless and has_ext(iexts, vk.khr_surface_extension_name)
    var platforms: List[str] = []
    if want_surface {
        enable.push(vk.khr_surface_extension_name)
        for name in [vk.khr_xlib_surface_extension_name, vk.khr_xcb_surface_extension_name, vk.khr_wayland_surface_extension_name, vk.khr_win32_surface_extension_name, vk.ext_metal_surface_extension_name] {
            if has_ext(iexts, name) {
                enable.push(name.clone())
                platforms.push(name)
            }
        }
    }
    var layers: List[str] = []
    if o.validation {
        var nl: u32 = 0
        discard entry.enumerate_instance_layer_properties(mut nl, Ptr.null())
        var lprops: List[vk.LayerProperties] = []
        for _ in 0..nl {
            lprops.push(vk.LayerProperties {})
        }
        discard entry.enumerate_instance_layer_properties(mut nl, lprops)
        let name = "VK_LAYER_KHRONOS_validation"
        if lprops.any(fn(p) => named(p.layer_name, name)) {
            layers.push(name)
        }
    }
    unsafe let lptrs = cstrs(layers)
    unsafe let app = vk.ApplicationInfo { p_application_name: o.app_name.as_cstr(), api_version: vk.api_version_1_3 }
    // Portability drivers (MoltenVK on macOS) are listed only when asked for.
    var iflags = vk.InstanceCreateFlags(0)
    if has_ext(iexts, vk.khr_portability_enumeration_extension_name) {
        enable.push(vk.khr_portability_enumeration_extension_name)
        iflags = vk.InstanceCreateFlags.ENUMERATE_PORTABILITY_KHR
    }
    unsafe let eptrs = cstrs(enable)
    unsafe let iinfo = vk.InstanceCreateInfo {
        flags: iflags,
        p_application_info: Ptr.of(app),
        enabled_layer_count: u32(lptrs.len()),
        pp_enabled_layer_names: lptrs.as_ptr(),
        enabled_extension_count: u32(eptrs.len()),
        pp_enabled_extension_names: eptrs.as_ptr(),
    }
    var instance = vk.Instance {}
    unsafe try ctx.ok(entry.create_instance(Ptr.of(iinfo), Ptr.null(), mut instance), "vkCreateInstance")
    let inst = ctx.Inst.load(fn(n) => st.get_instance_proc_addr(instance, n))

    let p = try pick(inst, instance)
    var dexts: List[vk.ExtensionProperties] = []
    var nd: u32 = 0
    discard inst.enumerate_device_extension_properties(p.pdev, Ptr.null(), mut nd, Ptr.null())
    for _ in 0..nd {
        dexts.push(vk.ExtensionProperties {})
    }
    discard inst.enumerate_device_extension_properties(p.pdev, Ptr.null(), mut nd, dexts)
    let want_swapchain = want_surface and has_ext(dexts, vk.khr_swapchain_extension_name)
    var denable: List[str] = []
    if want_swapchain {
        denable.push(vk.khr_swapchain_extension_name)
    }
    // Sharing: enabled whenever the driver has them (they cost nothing).
    var on: List[bool] = []
    // Required whenever the device has it (a portability implementation).
    if has_ext(dexts, vk.khr_portability_subset_extension_name) {
        denable.push(vk.khr_portability_subset_extension_name)
    }
    for name in [vk.khr_external_memory_fd_extension_name, vk.ext_external_memory_dma_buf_extension_name, vk.ext_image_drm_format_modifier_extension_name, vk.ext_queue_family_foreign_extension_name, vk.khr_external_semaphore_fd_extension_name] {
        let has_it = has_ext(dexts, name)
        on.push(has_it)
        if has_it {
            denable.push(name)
        }
    }
    let has_khr_prio = has_ext(dexts, vk.khr_global_priority_extension_name)
    let has_ext_prio = has_ext(dexts, vk.ext_global_priority_extension_name)
    let has_prio_query = has_khr_prio or has_ext(dexts, vk.ext_global_priority_query_extension_name)
    let prio_ext = if has_khr_prio {
        vk.khr_global_priority_extension_name
    } else if has_ext_prio {
        vk.ext_global_priority_extension_name
    } else {
        ""
    }
    let has_prio_ext = prio_ext != ""
    unsafe let dptrs = cstrs(denable)
    unsafe var dptrs_prio = cstrs(denable)
    if has_prio_ext {
        unsafe dptrs_prio.push(prio_ext.as_cstr())
    }

    // What the device has, then what we turn on: the required set plus a
    // few widely supported extras shaders often want.
    var has12 = vk.PhysicalDeviceVulkan12Features {}
    var has13 = vk.PhysicalDeviceVulkan13Features {}
    var has = vk.PhysicalDeviceFeatures2 {}
    unsafe {
        has12.p_next = Ptr.of_mut(mut has13).cast[u8]()
        has.p_next = Ptr.of_mut(mut has12).cast[u8]()
    }
    inst.get_physical_device_features2(p.pdev, mut has)
    var f13 = vk.PhysicalDeviceVulkan13Features {
        dynamic_rendering: 1,
        synchronization2: 1,
        maintenance4: has13.maintenance4,
        shader_demote_to_helper_invocation: has13.shader_demote_to_helper_invocation,
        shader_terminate_invocation: has13.shader_terminate_invocation,
    }
    var f12 = vk.PhysicalDeviceVulkan12Features {
        timeline_semaphore: 1,
        buffer_device_address: 1,
        runtime_descriptor_array: 1,
        descriptor_binding_partially_bound: 1,
        descriptor_binding_sampled_image_update_after_bind: 1,
        descriptor_binding_storage_image_update_after_bind: 1,
        descriptor_binding_update_unused_while_pending: 1,
        shader_sampled_image_array_non_uniform_indexing: 1,
        separate_depth_stencil_layouts: 1,
        shader_storage_image_array_non_uniform_indexing: has12.shader_storage_image_array_non_uniform_indexing,
        scalar_block_layout: has12.scalar_block_layout,
        shader_float16: has12.shader_float16,
        shader_int8: has12.shader_int8,
    }
    var f = vk.PhysicalDeviceFeatures2 {
        features: vk.PhysicalDeviceFeatures {
            shader_int64: has.features.shader_int64,
            shader_storage_image_write_without_format: has.features.shader_storage_image_write_without_format,
            shader_storage_image_read_without_format: has.features.shader_storage_image_read_without_format,
            sampler_anisotropy: has.features.sampler_anisotropy,
        },
    }
    unsafe {
        f12.p_next = Ptr.of_mut(mut f13).cast[u8]()
        f.p_next = Ptr.of_mut(mut f12).cast[u8]()
    }

    var prio: f32 = 1.0
    var dev = vk.Device {}
    var granted = device.Priority.Default
    var created = false
    if o.priority != device.Priority.Default and has_prio_ext {
        let supported_p = if has_prio_query { supported_priorities(inst, p.pdev, p.family) } else { [] }
        for cand in priority_candidates(o.priority) {
            if not supported_p.is_empty() and not supported_p.contains(cand.as_i32()) {
                continue
            }
            let qp = vk.DeviceQueueGlobalPriorityCreateInfo { global_priority: vk.QueueGlobalPriority(cand.as_i32()) }
            unsafe let qinfo = vk.DeviceQueueCreateInfo { p_next: Ptr.of(qp).cast[u8](), queue_family_index: p.family, queue_count: 1, p_queue_priorities: Ptr.of(prio) }
            unsafe let dinfo = vk.DeviceCreateInfo {
                p_next: Ptr.of(f).cast[u8](),
                queue_create_info_count: 1,
                p_queue_create_infos: Ptr.of(qinfo),
                enabled_extension_count: u32(dptrs_prio.len()),
                pp_enabled_extension_names: dptrs_prio.as_ptr(),
            }
            unsafe let r = inst.create_device(p.pdev, Ptr.of(dinfo), Ptr.null(), mut dev)
            if r == vk.VkResult.SUCCESS {
                granted = cand
                created = true
                break
            }
        }
    }
    if not created {
        unsafe let qinfo = vk.DeviceQueueCreateInfo { queue_family_index: p.family, queue_count: 1, p_queue_priorities: Ptr.of(prio) }
        unsafe let dinfo = vk.DeviceCreateInfo {
            p_next: Ptr.of(f).cast[u8](),
            queue_create_info_count: 1,
            p_queue_create_infos: Ptr.of(qinfo),
            enabled_extension_count: u32(dptrs.len()),
            pp_enabled_extension_names: dptrs.as_ptr(),
        }
        unsafe try ctx.ok(inst.create_device(p.pdev, Ptr.of(dinfo), Ptr.null(), mut dev), "vkCreateDevice")
    }
    let fns = ctx.Dev.load(fn(n) => inst.get_device_proc_addr(dev, n))
    var queue = vk.Queue {}
    fns.get_device_queue(dev, p.family, 0, mut queue)

    var drm = vk.PhysicalDeviceDrmPropertiesEXT {}
    var p12 = vk.PhysicalDeviceVulkan12Properties {}
    var props = vk.PhysicalDeviceProperties2 {}
    let has_drm = has_ext(dexts, vk.ext_physical_device_drm_extension_name)
    unsafe {
        if has_drm {
            p12.p_next = Ptr.of_mut(mut drm).cast[u8]()
        }
        props.p_next = Ptr.of_mut(mut p12).cast[u8]()
    }
    inst.get_physical_device_properties2(p.pdev, mut props)
    var drm_node: Option[(i64, i64)] = None
    if has_drm and drm.has_render != 0 {
        drm_node = Some((drm.render_major, drm.render_minor))
    } else if has_drm and drm.has_primary != 0 {
        drm_node = Some((drm.primary_major, drm.primary_minor))
    }
    var limit = p12.max_descriptor_set_update_after_bind_sampled_images
    limit = min(limit, p12.max_descriptor_set_update_after_bind_storage_images)
    limit = min(limit, p12.max_per_stage_descriptor_update_after_bind_sampled_images)
    limit = min(limit, p12.max_per_stage_descriptor_update_after_bind_storage_images)
    limit = min(limit, (p12.max_per_stage_update_after_bind_resources - 4) / 2)
    // Exact, because shaders clamp indices to it (GPU_MAX_TEXTURES).
    guard o.max_textures <= limit and o.max_textures >= 2 else {
        fns.destroy_device(dev, Ptr.null())
        inst.destroy_instance(instance, Ptr.null())
        return Err("max_textures {o.max_textures} is outside 2..{limit} for this device (and GPU_MAX_TEXTURES in shaders)")
    }
    let slots = o.max_textures
    let bl = try bindless.create(fns, dev, slots)

    var mem_props = vk.PhysicalDeviceMemoryProperties {}
    inst.get_physical_device_memory_properties(p.pdev, mut mem_props)

    let cx = ctx.Ctx {
        inst,
        fns,
        cmd: ctx.Cmds.load(fn(n) => inst.get_device_proc_addr(dev, n)),
        instance,
        pdev: p.pdev,
        device: dev,
        queue,
        family: p.family,
        foreign: if on[3] { vk.queue_family_foreign_ext } else { vk.queue_family_external },
        layout: bl.layout,
        set: bl.set,
    }
    let wsi = Wsi {
        surf: if want_surface { vk.KhrSurfaceInstanceFn.try_load(fn(n) => st.get_instance_proc_addr(instance, n)) } else { None },
        platforms,
        swapchain: if want_swapchain { vk.KhrSwapchainDeviceFn.try_load(fn(n) => inst.get_device_proc_addr(dev, n)) } else { None },
    }
    let ext = External {
        mem_fd: if on[0] { vk.KhrExternalMemoryFdDeviceFn.try_load(fn(n) => inst.get_device_proc_addr(dev, n)) } else { None },
        sem_fd: if on[4] { vk.KhrExternalSemaphoreFdDeviceFn.try_load(fn(n) => inst.get_device_proc_addr(dev, n)) } else { None },
        drm: if on[2] { vk.ExtImageDrmFormatModifierDeviceFn.try_load(fn(n) => inst.get_device_proc_addr(dev, n)) } else { None },
        dmabuf: on[1],
    }
    return Ok(Base { cx, wsi, ext, bl, max_textures: slots, max_groups: props.properties.limits.max_compute_work_group_count, mem_props, drm_node, priority: granted })
}

/// The best Vulkan 1.3 device with every required feature (discrete over
/// integrated over the rest), and its first graphics + compute family.
fn pick(inst: ctx.Inst, instance: vk.Instance) -> Result[Pick, str] {
    var count: u32 = 0
    try ctx.ok(inst.enumerate_physical_devices(instance, mut count, Ptr.null()), "vkEnumeratePhysicalDevices")
    var pdevs: List[vk.PhysicalDevice] = []
    for _ in 0..count {
        pdevs.push(vk.PhysicalDevice {})
    }
    try ctx.ok(inst.enumerate_physical_devices(instance, mut count, pdevs), "vkEnumeratePhysicalDevices")
    var best = Pick { pdev: vk.PhysicalDevice {}, family: 0, score: -1 }
    for pd in pdevs {
        var props = vk.PhysicalDeviceProperties {}
        inst.get_physical_device_properties(pd, mut props)
        guard props.api_version >= vk.api_version_1_3 and supported(inst, pd) else {
            continue
        }
        var n: u32 = 0
        inst.get_physical_device_queue_family_properties(pd, mut n, Ptr.null())
        var fams: List[vk.QueueFamilyProperties] = []
        for _ in 0..n {
            fams.push(vk.QueueFamilyProperties {})
        }
        inst.get_physical_device_queue_family_properties(pd, mut n, fams)
        let both = vk.QueueFlags.GRAPHICS | vk.QueueFlags.COMPUTE
        guard let Some(family) = fams.position(fn(f) => f.queue_flags.contains(both)) else {
            continue
        }
        let score = match props.device_type {
            DISCRETE_GPU => 3
            INTEGRATED_GPU => 2
            VIRTUAL_GPU => 1
            _ => 0
        }
        if score > best.score {
            best = Pick { pdev: pd, family: u32(family), score }
        }
    }
    guard best.score >= 0 else {
        return Err("no Vulkan 1.3 device with dynamic rendering, synchronization2, timeline semaphores, buffer device address and descriptor indexing")
    }
    return Ok(best)
}

fn supported(inst: ctx.Inst, pd: vk.PhysicalDevice) -> bool {
    var f12 = vk.PhysicalDeviceVulkan12Features {}
    var f13 = vk.PhysicalDeviceVulkan13Features {}
    var f = vk.PhysicalDeviceFeatures2 {}
    unsafe {
        f12.p_next = Ptr.of_mut(mut f13).cast[u8]()
        f.p_next = Ptr.of_mut(mut f12).cast[u8]()
    }
    inst.get_physical_device_features2(pd, mut f)
    return f13.dynamic_rendering == 1 and f13.synchronization2 == 1 and f12.timeline_semaphore == 1 and f12.buffer_device_address == 1 and f12.runtime_descriptor_array == 1 and f12.descriptor_binding_partially_bound == 1 and f12.descriptor_binding_sampled_image_update_after_bind == 1 and f12.descriptor_binding_storage_image_update_after_bind == 1 and f12.descriptor_binding_update_unused_while_pending == 1 and f12.shader_sampled_image_array_non_uniform_indexing == 1 and f12.separate_depth_stencil_layouts == 1
}
