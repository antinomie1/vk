// The raw device: handles and command tables every module needs, in one
// Copy value so helpers borrow it instead of the whole `Device`.

import vk

/// The commands an `Encoder` records, resolved once per device.
extern table Cmds {
    fn begin(command_buffer: vk.CommandBuffer, p_begin_info: Ptr[vk.CommandBufferBeginInfo]) -> vk.VkResult = "vkBeginCommandBuffer"
    fn end(command_buffer: vk.CommandBuffer) -> vk.VkResult = "vkEndCommandBuffer"
    fn barrier(command_buffer: vk.CommandBuffer, p_dependency_info: Ptr[vk.DependencyInfo]) = "vkCmdPipelineBarrier2"
    fn begin_rendering(command_buffer: vk.CommandBuffer, p_rendering_info: Ptr[vk.RenderingInfo]) = "vkCmdBeginRendering"
    fn end_rendering(command_buffer: vk.CommandBuffer) = "vkCmdEndRendering"
    fn bind_pipeline(command_buffer: vk.CommandBuffer, bind_point: vk.PipelineBindPoint, pipeline: vk.Pipeline) = "vkCmdBindPipeline"
    fn bind_sets(command_buffer: vk.CommandBuffer, bind_point: vk.PipelineBindPoint, layout: vk.PipelineLayout, first_set: u32, count: u32, p_sets: Ptr[vk.DescriptorSet], dynamic_count: u32, p_dynamic: Ptr[u32]) = "vkCmdBindDescriptorSets"
    fn push_constants(command_buffer: vk.CommandBuffer, layout: vk.PipelineLayout, stages: vk.ShaderStageFlags, offset: u32, size: u32, p_values: Ptr[u8]) = "vkCmdPushConstants"
    fn set_viewport(command_buffer: vk.CommandBuffer, first: u32, count: u32, p_viewports: Ptr[vk.Viewport]) = "vkCmdSetViewport"
    fn set_scissor(command_buffer: vk.CommandBuffer, first: u32, count: u32, p_scissors: Ptr[vk.Rect2D]) = "vkCmdSetScissor"
    fn bind_index_buffer(command_buffer: vk.CommandBuffer, buffer: vk.Buffer, offset: u64, index_type: vk.IndexType) = "vkCmdBindIndexBuffer"
    fn draw(command_buffer: vk.CommandBuffer, vertex_count: u32, instance_count: u32, first_vertex: u32, first_instance: u32) = "vkCmdDraw"
    fn draw_indexed(command_buffer: vk.CommandBuffer, index_count: u32, instance_count: u32, first_index: u32, vertex_offset: i32, first_instance: u32) = "vkCmdDrawIndexed"
    fn draw_indirect(command_buffer: vk.CommandBuffer, buffer: vk.Buffer, offset: u64, draw_count: u32, stride: u32) = "vkCmdDrawIndirect"
    fn dispatch(command_buffer: vk.CommandBuffer, x: u32, y: u32, z: u32) = "vkCmdDispatch"
    fn dispatch_indirect(command_buffer: vk.CommandBuffer, buffer: vk.Buffer, offset: u64) = "vkCmdDispatchIndirect"
    fn copy_buffer(command_buffer: vk.CommandBuffer, src: vk.Buffer, dst: vk.Buffer, count: u32, p_regions: Ptr[vk.BufferCopy]) = "vkCmdCopyBuffer"
    fn copy_buffer_to_image(command_buffer: vk.CommandBuffer, src: vk.Buffer, dst: vk.Image, layout: vk.ImageLayout, count: u32, p_regions: Ptr[vk.BufferImageCopy]) = "vkCmdCopyBufferToImage"
    fn clear_color_image(command_buffer: vk.CommandBuffer, image: vk.Image, layout: vk.ImageLayout, p_color: Ptr[vk.ClearColorValue], count: u32, p_ranges: Ptr[vk.ImageSubresourceRange]) = "vkCmdClearColorImage"
    fn copy_image_to_buffer(command_buffer: vk.CommandBuffer, src: vk.Image, layout: vk.ImageLayout, dst: vk.Buffer, count: u32, p_regions: Ptr[vk.BufferImageCopy]) = "vkCmdCopyImageToBuffer"
}

/// The device commands vk_gpu calls (besides recording), loaded once: a
/// table of only these keeps loading and `Ctx` small.
extern table Dev {
    fn allocate_command_buffers(device: vk.Device, p_allocate_info: Ptr[vk.CommandBufferAllocateInfo], p_command_buffers: Ptr[vk.CommandBuffer]) -> vk.VkResult = "vkAllocateCommandBuffers"
    fn allocate_descriptor_sets(device: vk.Device, p_allocate_info: Ptr[vk.DescriptorSetAllocateInfo], p_descriptor_sets: Ptr[vk.DescriptorSet]) -> vk.VkResult = "vkAllocateDescriptorSets"
    fn allocate_memory(device: vk.Device, p_allocate_info: Ptr[vk.MemoryAllocateInfo], p_allocator: Ptr[vk.AllocationCallbacks], mut p_memory: vk.DeviceMemory) -> vk.VkResult = "vkAllocateMemory"
    fn bind_buffer_memory(device: vk.Device, buffer: vk.Buffer, memory: vk.DeviceMemory, memory_offset: vk.DeviceSize) -> vk.VkResult = "vkBindBufferMemory"
    fn bind_image_memory(device: vk.Device, image: vk.Image, memory: vk.DeviceMemory, memory_offset: vk.DeviceSize) -> vk.VkResult = "vkBindImageMemory"
    fn create_buffer(device: vk.Device, p_create_info: Ptr[vk.BufferCreateInfo], p_allocator: Ptr[vk.AllocationCallbacks], mut p_buffer: vk.Buffer) -> vk.VkResult = "vkCreateBuffer"
    fn create_command_pool(device: vk.Device, p_create_info: Ptr[vk.CommandPoolCreateInfo], p_allocator: Ptr[vk.AllocationCallbacks], mut p_command_pool: vk.CommandPool) -> vk.VkResult = "vkCreateCommandPool"
    fn create_compute_pipelines(device: vk.Device, pipeline_cache: vk.PipelineCache, create_info_count: u32, p_create_infos: Ptr[vk.ComputePipelineCreateInfo], p_allocator: Ptr[vk.AllocationCallbacks], p_pipelines: Ptr[vk.Pipeline]) -> vk.VkResult = "vkCreateComputePipelines"
    fn create_descriptor_pool(device: vk.Device, p_create_info: Ptr[vk.DescriptorPoolCreateInfo], p_allocator: Ptr[vk.AllocationCallbacks], mut p_descriptor_pool: vk.DescriptorPool) -> vk.VkResult = "vkCreateDescriptorPool"
    fn create_descriptor_set_layout(device: vk.Device, p_create_info: Ptr[vk.DescriptorSetLayoutCreateInfo], p_allocator: Ptr[vk.AllocationCallbacks], mut p_set_layout: vk.DescriptorSetLayout) -> vk.VkResult = "vkCreateDescriptorSetLayout"
    fn create_graphics_pipelines(device: vk.Device, pipeline_cache: vk.PipelineCache, create_info_count: u32, p_create_infos: Ptr[vk.GraphicsPipelineCreateInfo], p_allocator: Ptr[vk.AllocationCallbacks], p_pipelines: Ptr[vk.Pipeline]) -> vk.VkResult = "vkCreateGraphicsPipelines"
    fn create_image(device: vk.Device, p_create_info: Ptr[vk.ImageCreateInfo], p_allocator: Ptr[vk.AllocationCallbacks], mut p_image: vk.Image) -> vk.VkResult = "vkCreateImage"
    fn create_image_view(device: vk.Device, p_create_info: Ptr[vk.ImageViewCreateInfo], p_allocator: Ptr[vk.AllocationCallbacks], mut p_view: vk.ImageView) -> vk.VkResult = "vkCreateImageView"
    fn create_pipeline_layout(device: vk.Device, p_create_info: Ptr[vk.PipelineLayoutCreateInfo], p_allocator: Ptr[vk.AllocationCallbacks], mut p_pipeline_layout: vk.PipelineLayout) -> vk.VkResult = "vkCreatePipelineLayout"
    fn create_sampler(device: vk.Device, p_create_info: Ptr[vk.SamplerCreateInfo], p_allocator: Ptr[vk.AllocationCallbacks], mut p_sampler: vk.Sampler) -> vk.VkResult = "vkCreateSampler"
    fn create_semaphore(device: vk.Device, p_create_info: Ptr[vk.SemaphoreCreateInfo], p_allocator: Ptr[vk.AllocationCallbacks], mut p_semaphore: vk.Semaphore) -> vk.VkResult = "vkCreateSemaphore"
    fn create_shader_module(device: vk.Device, p_create_info: Ptr[vk.ShaderModuleCreateInfo], p_allocator: Ptr[vk.AllocationCallbacks], mut p_shader_module: vk.ShaderModule) -> vk.VkResult = "vkCreateShaderModule"
    fn destroy_buffer(device: vk.Device, buffer: vk.Buffer, p_allocator: Ptr[vk.AllocationCallbacks]) = "vkDestroyBuffer"
    fn destroy_command_pool(device: vk.Device, command_pool: vk.CommandPool, p_allocator: Ptr[vk.AllocationCallbacks]) = "vkDestroyCommandPool"
    fn destroy_descriptor_pool(device: vk.Device, descriptor_pool: vk.DescriptorPool, p_allocator: Ptr[vk.AllocationCallbacks]) = "vkDestroyDescriptorPool"
    fn destroy_descriptor_set_layout(device: vk.Device, descriptor_set_layout: vk.DescriptorSetLayout, p_allocator: Ptr[vk.AllocationCallbacks]) = "vkDestroyDescriptorSetLayout"
    fn destroy_device(device: vk.Device, p_allocator: Ptr[vk.AllocationCallbacks]) = "vkDestroyDevice"
    fn destroy_image(device: vk.Device, image: vk.Image, p_allocator: Ptr[vk.AllocationCallbacks]) = "vkDestroyImage"
    fn destroy_image_view(device: vk.Device, image_view: vk.ImageView, p_allocator: Ptr[vk.AllocationCallbacks]) = "vkDestroyImageView"
    fn destroy_pipeline(device: vk.Device, pipeline: vk.Pipeline, p_allocator: Ptr[vk.AllocationCallbacks]) = "vkDestroyPipeline"
    fn destroy_pipeline_layout(device: vk.Device, pipeline_layout: vk.PipelineLayout, p_allocator: Ptr[vk.AllocationCallbacks]) = "vkDestroyPipelineLayout"
    fn destroy_sampler(device: vk.Device, sampler: vk.Sampler, p_allocator: Ptr[vk.AllocationCallbacks]) = "vkDestroySampler"
    fn destroy_semaphore(device: vk.Device, semaphore: vk.Semaphore, p_allocator: Ptr[vk.AllocationCallbacks]) = "vkDestroySemaphore"
    fn destroy_shader_module(device: vk.Device, shader_module: vk.ShaderModule, p_allocator: Ptr[vk.AllocationCallbacks]) = "vkDestroyShaderModule"
    fn device_wait_idle(device: vk.Device) -> vk.VkResult = "vkDeviceWaitIdle"
    fn free_memory(device: vk.Device, memory: vk.DeviceMemory, p_allocator: Ptr[vk.AllocationCallbacks]) = "vkFreeMemory"
    fn get_buffer_device_address(device: vk.Device, p_info: Ptr[vk.BufferDeviceAddressInfo]) -> vk.DeviceAddress = "vkGetBufferDeviceAddress"
    fn get_buffer_memory_requirements(device: vk.Device, buffer: vk.Buffer, mut p_memory_requirements: vk.MemoryRequirements) = "vkGetBufferMemoryRequirements"
    fn get_device_queue(device: vk.Device, queue_family_index: u32, queue_index: u32, mut p_queue: vk.Queue) = "vkGetDeviceQueue"
    fn get_image_memory_requirements(device: vk.Device, image: vk.Image, mut p_memory_requirements: vk.MemoryRequirements) = "vkGetImageMemoryRequirements"
    fn get_image_subresource_layout(device: vk.Device, image: vk.Image, p_subresource: Ptr[vk.ImageSubresource], mut p_layout: vk.SubresourceLayout) = "vkGetImageSubresourceLayout"
    fn get_semaphore_counter_value(device: vk.Device, semaphore: vk.Semaphore, mut p_value: u64) -> vk.VkResult = "vkGetSemaphoreCounterValue"
    fn map_memory(device: vk.Device, memory: vk.DeviceMemory, offset: vk.DeviceSize, size: vk.DeviceSize, flags: vk.MemoryMapFlags, mut pp_data: Ptr[u8]) -> vk.VkResult = "vkMapMemory"
    fn queue_submit2(queue: vk.Queue, submit_count: u32, p_submits: Ptr[vk.SubmitInfo2], fence: vk.Fence) -> vk.VkResult = "vkQueueSubmit2"
    fn reset_command_buffer(command_buffer: vk.CommandBuffer, flags: vk.CommandBufferResetFlags) -> vk.VkResult = "vkResetCommandBuffer"
    fn update_descriptor_sets(device: vk.Device, descriptor_write_count: u32, p_descriptor_writes: Ptr[vk.WriteDescriptorSet], descriptor_copy_count: u32, p_descriptor_copies: Ptr[vk.CopyDescriptorSet]) = "vkUpdateDescriptorSets"
    fn wait_semaphores(device: vk.Device, p_wait_info: Ptr[vk.SemaphoreWaitInfo], timeout: u64) -> vk.VkResult = "vkWaitSemaphores"
}

/// The instance commands vk_gpu calls.
extern table Inst {
    fn create_device(physical_device: vk.PhysicalDevice, p_create_info: Ptr[vk.DeviceCreateInfo], p_allocator: Ptr[vk.AllocationCallbacks], mut p_device: vk.Device) -> vk.VkResult = "vkCreateDevice"
    fn destroy_instance(instance: vk.Instance, p_allocator: Ptr[vk.AllocationCallbacks]) = "vkDestroyInstance"
    fn enumerate_device_extension_properties(physical_device: vk.PhysicalDevice, p_layer_name: Ptr[u8], mut p_property_count: u32, p_properties: Ptr[vk.ExtensionProperties]) -> vk.VkResult = "vkEnumerateDeviceExtensionProperties"
    fn enumerate_physical_devices(instance: vk.Instance, mut p_physical_device_count: u32, p_physical_devices: Ptr[vk.PhysicalDevice]) -> vk.VkResult = "vkEnumeratePhysicalDevices"
    fn get_device_proc_addr(device: vk.Device, p_name: str) -> Option[vk.PFN_vkVoidFunction] = "vkGetDeviceProcAddr"
    fn get_physical_device_features2(physical_device: vk.PhysicalDevice, mut p_features: vk.PhysicalDeviceFeatures2) = "vkGetPhysicalDeviceFeatures2"
    fn get_physical_device_format_properties2(physical_device: vk.PhysicalDevice, format: vk.Format, mut p_format_properties: vk.FormatProperties2) = "vkGetPhysicalDeviceFormatProperties2"
    fn get_physical_device_memory_properties(physical_device: vk.PhysicalDevice, mut p_memory_properties: vk.PhysicalDeviceMemoryProperties) = "vkGetPhysicalDeviceMemoryProperties"
    fn get_physical_device_properties(physical_device: vk.PhysicalDevice, mut p_properties: vk.PhysicalDeviceProperties) = "vkGetPhysicalDeviceProperties"
    fn get_physical_device_properties2(physical_device: vk.PhysicalDevice, mut p_properties: vk.PhysicalDeviceProperties2) = "vkGetPhysicalDeviceProperties2"
    fn get_physical_device_queue_family_properties(physical_device: vk.PhysicalDevice, mut p_queue_family_property_count: u32, p_queue_family_properties: Ptr[vk.QueueFamilyProperties]) = "vkGetPhysicalDeviceQueueFamilyProperties"
}

struct Ctx {
    inst: Inst
    fns: Dev
    cmd: Cmds
    instance: vk.Instance
    pdev: vk.PhysicalDevice
    device: vk.Device
    queue: vk.Queue
    family: u32
    /// Queue family of imported resources' producers (FOREIGN when available).
    foreign: u32
    /// The one pipeline layout: the bindless set and 128 bytes of push constants.
    layout: vk.PipelineLayout
    set: vk.DescriptorSet
}

/// Push constant bytes every pipeline gets (the guaranteed minimum).
let push_size: u32 = 128

fn push_stages() -> vk.ShaderStageFlags {
    return vk.ShaderStageFlags.ALL_GRAPHICS | vk.ShaderStageFlags.COMPUTE
}

/// `Err` naming the call unless `r` is `SUCCESS`.
fn ok(r: vk.VkResult, what: str) -> Result[(), str] {
    guard r == vk.VkResult.SUCCESS else {
        return Err("{what}: {r}")
    }
    return Ok(())
}
