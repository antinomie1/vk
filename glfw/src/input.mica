// Input values and the events a window reports.

import glfw_sys as sys
import key

pub enum Action: i32 derive(Show) {
    Release = 0
    Press = 1
    Repeat = 2
}

pub enum Mods: u32 derive(Flags, Show) {
    SHIFT = 1
    CONTROL = 2
    ALT = 4
    SUPER = 8
    CAPS_LOCK = 16
    NUM_LOCK = 32
}

pub enum MouseButton: i32 derive(Show) {
    Left = 0
    Right = 1
    Middle = 2
    Button4 = 3
    Button5 = 4
    Button6 = 5
    Button7 = 6
    Button8 = 7
}

pub enum CursorMode {
    Normal
    /// Invisible over the window.
    Hidden
    /// Hidden and locked to the window, for unlimited motion (cameras).
    Disabled
    /// Visible but confined to the window.
    Captured
}

pub enum StandardCursor {
    Arrow
    IBeam
    Crosshair
    PointingHand
    ResizeEW
    ResizeNS
    ResizeNWSE
    ResizeNESW
    ResizeAll
    NotAllowed
}

/// What happened to a window since the last `Window.events`.
pub enum Event {
    /// A key with its platform scancode.
    Key(key.Key, i32, Action, Mods)
    /// A typed Unicode code point.
    Char(u32)
    MouseButton(MouseButton, Action, Mods)
    /// Cursor position in screen coordinates, from the content's top left.
    CursorPos(f64, f64)
    CursorEnter(bool)
    Scroll(f64, f64)
    Pos(i32, i32)
    /// Size in screen coordinates.
    Size(i32, i32)
    /// Size in pixels: resize the swapchain.
    FramebufferSize(i32, i32)
    ContentScale(f32, f32)
    Close
    Refresh
    Focus(bool)
    Iconify(bool)
    Maximize(bool)
    /// Paths dropped onto the window.
    FileDrop(List[str])
}

fn action(a: i32) -> Action {
    return Action.from(a).unwrap_or(Action.Release)
}

fn mods(m: i32) -> Mods {
    return Mods.from_bits(u32(m) & 63)
}

fn cursor_mode(m: CursorMode) -> i32 {
    return match m {
        Normal => i32(sys.cursor_normal)
        Hidden => i32(sys.cursor_hidden)
        Disabled => i32(sys.cursor_disabled)
        Captured => i32(sys.cursor_captured)
    }
}

fn shape(c: StandardCursor) -> i32 {
    return match c {
        Arrow => i32(sys.arrow_cursor)
        IBeam => i32(sys.ibeam_cursor)
        Crosshair => i32(sys.crosshair_cursor)
        PointingHand => i32(sys.pointing_hand_cursor)
        ResizeEW => i32(sys.resize_ew_cursor)
        ResizeNS => i32(sys.resize_ns_cursor)
        ResizeNWSE => i32(sys.resize_nwse_cursor)
        ResizeNESW => i32(sys.resize_nesw_cursor)
        ResizeAll => i32(sys.resize_all_cursor)
        NotAllowed => i32(sys.not_allowed_cursor)
    }
}
