// A scene composited into a 32x32 offscreen target on the real device:
// moves redraw only their damage, idle frames draw nothing, a new buffer
// redraws only its client's damage (mapped through transforms), opaque
// views hide what is under them, and a window backed by an imported dmabuf
// is acquired, sampled, released and offered for direct scanout.

import vk_gpu as gpu
import vk_draw2d as draw2d
import vk_compose as compose

fn solid(mut dev: gpu.Device, w: u32, h: u32, rgba: [4]u8) -> gpu.Texture {
    let t = dev.texture(gpu.TextureDesc { width: w, height: h, opaque: rgba[3] == 255 }).unwrap()
    var data: List[u8] = []
    for _ in 0..int(w * h) {
        for b in rgba {
            data.push(b)
        }
    }
    var e = dev.encoder().unwrap()
    dev.write_texture(mut e, t, data).unwrap()
    discard dev.submit(take e).unwrap()
    return t
}

/// Composite one frame; whether anything was drawn, and the pixels.
fn frame(mut dev: gpu.Device, mut c: draw2d.Canvas, mut s: compose.Scene, mut out: gpu.Offscreen) -> (bool, List[u8]) {
    let f = out.acquire(mut dev).unwrap().unwrap()
    var e = dev.encoder().unwrap()
    let drew = s.render(mut dev, mut c, mut e, f).unwrap()
    discard out.present(mut dev, f, take e).unwrap()
    return (drew, dev.read_texture(out.texture()).unwrap())
}

fn px(img: List[u8], x: int, y: int) -> (u8, u8, u8, u8) {
    let i = (y * 32 + x) * 4
    return (img[i], img[i + 1], img[i + 2], img[i + 3])
}

let black = (u8(0), u8(0), u8(0), u8(255))
let red = (u8(255), u8(0), u8(0), u8(255))

test "damage follows moves and idle frames draw nothing" {
    guard let Ok(d) = gpu.Device.open(gpu.Options { headless: true, validation: true }) else {
        return
    }
    var dev = d
    var out = gpu.Offscreen.create(mut dev, 32, 32, gpu.Format.R8G8B8A8_UNORM).unwrap()
    var c = draw2d.Canvas.create(mut dev, gpu.Format.R8G8B8A8_UNORM).unwrap()
    var s = compose.Scene.new(32, 32, vec4(0.0, 0.0, 0.0, 1.0))
    let id = s.add(compose.View { tex: solid(mut dev, 8, 8, [255, 0, 0, 255]) })

    let (drew, img) = frame(mut dev, mut c, mut s, mut out)
    assert(drew)
    assert_eq(px(img, 2, 2), red)
    assert_eq(px(img, 20, 20), black)
    assert(s.idle())
    let (again, _) = frame(mut dev, mut c, mut s, mut out)
    assert(not again)

    var v = s.get(id).unwrap()
    v.x = 16.0
    v.y = 16.0
    s.set(id, v)
    assert(not s.idle())
    let (moved, img2) = frame(mut dev, mut c, mut s, mut out)
    assert(moved)
    assert_eq(px(img2, 2, 2), black)
    assert_eq(px(img2, 18, 18), red)

    // A blue window on top, half transparent, then raised and removed.
    let top = s.add(compose.View { tex: solid(mut dev, 32, 32, [0, 0, 255, 255]), opacity: 0.5 })
    let (_, img3) = frame(mut dev, mut c, mut s, mut out)
    let (r, g, b, a) = px(img3, 18, 18)
    assert(r > 120 and r < 135 and b > 120 and b < 135)
    s.remove(top)
    let (_, img4) = frame(mut dev, mut c, mut s, mut out)
    assert_eq(px(img4, 18, 18), red)
    assert_eq(px(img4, 2, 2), black)
}

test "an imported dmabuf window" {
    guard let Ok(d) = gpu.Device.open(gpu.Options { headless: true, validation: true }) else {
        return
    }
    var dev = d
    // Stand-in client: renders green into a buffer it shares as a dmabuf.
    guard let Ok((client, buf)) = dev.export_dmabuf(gpu.TextureDesc { width: 8, height: 8 }) else {
        return
    }
    var e = dev.encoder().unwrap()
    e.render(gpu.Pass { target: client, clear: [0.0, 1.0, 0.0, 1.0] }, fn(mut r) {})
    let (_, fence) = dev.submit_sync_file(take e).unwrap()

    let tex = dev.import_dmabuf(buf).unwrap()
    dev.wait_sync_file(fence).unwrap()
    var out = gpu.Offscreen.create(mut dev, 32, 32, gpu.Format.R8G8B8A8_UNORM).unwrap()
    var c = draw2d.Canvas.create(mut dev, gpu.Format.R8G8B8A8_UNORM).unwrap()
    var s = compose.Scene.new(32, 32, vec4(0.0, 0.0, 0.0, 1.0))
    discard s.add(compose.View { tex, x: 4.0, y: 4.0, w: 16.0, h: 16.0, radius: 4.0, shadow: 4.0 })
    let (_, img) = frame(mut dev, mut c, mut s, mut out)
    assert_eq(px(img, 12, 12), (u8(0), u8(255), u8(0), u8(255)))
    assert_eq(px(img, 30, 30), black)
}

fn setup() -> Option[(gpu.Device, gpu.Offscreen, draw2d.Canvas)] {
    guard let Ok(d) = gpu.Device.open(gpu.Options { headless: true, validation: true }) else {
        return None
    }
    var dev = d
    let out = gpu.Offscreen.create(mut dev, 32, 32, gpu.Format.R8G8B8A8_UNORM).unwrap()
    let c = draw2d.Canvas.create(mut dev, gpu.Format.R8G8B8A8_UNORM).unwrap()
    return Some((dev, out, c))
}

let blue = (u8(0), u8(0), u8(255), u8(255))

test "a new buffer redraws only the client's damage" {
    guard let Some((d, o, cv)) = setup() else {
        return
    }
    var dev = d
    var out = o
    var c = cv
    var s = compose.Scene.new(32, 32, vec4(0.0, 0.0, 0.0, 1.0))
    let id = s.add(compose.View { tex: solid(mut dev, 8, 8, [255, 0, 0, 255]) })
    discard frame(mut dev, mut c, mut s, mut out)
    var v = s.get(id).unwrap()
    v.tex = solid(mut dev, 8, 8, [0, 0, 255, 255])
    s.set(id, v)
    assert(s.idle())
    s.commit(id, Some(compose.Rect { w: 2.0, h: 2.0 }))
    let (_, img) = frame(mut dev, mut c, mut s, mut out)
    assert_eq(s.changed().len(), 1)
    assert_eq(s.changed()[0], compose.Rect { w: 3.0, h: 3.0 })
    assert_eq(px(img, 1, 1), blue)
    assert_eq(px(img, 6, 6), red)
}

test "client damage maps through the transform and scale" {
    guard let Some((d, o, cv)) = setup() else {
        return
    }
    var dev = d
    var out = o
    var c = cv
    var s = compose.Scene.new(32, 32, vec4(0.0, 0.0, 0.0, 1.0))
    // A 4x2 buffer turned 90 degrees is 2x4 upright, shown at 8x16.
    let id = s.add(compose.View { tex: solid(mut dev, 4, 2, [255, 0, 0, 255]), w: 8.0, h: 16.0, transform: compose.Transform.Rot90 })
    discard frame(mut dev, mut c, mut s, mut out)
    // Its first texel shows at the top right: x 4..8, y 0..4, plus a pixel.
    s.commit(id, Some(compose.Rect { w: 1.0, h: 1.0 }))
    discard frame(mut dev, mut c, mut s, mut out)
    assert_eq(s.changed().len(), 1)
    assert_eq(s.changed()[0], compose.Rect { x: 3.0, y: 0.0, w: 5.0, h: 5.0 })
}

test "opaque views hide what is under them" {
    guard let Some((d, o, cv)) = setup() else {
        return
    }
    var dev = d
    var s = compose.Scene.new(32, 32, vec4(0.0, 0.0, 0.0, 1.0))
    let below = s.add(compose.View { tex: solid(mut dev, 8, 8, [255, 0, 0, 255]), x: 4.0, y: 4.0 })
    let top = s.add(compose.View { tex: solid(mut dev, 16, 16, [0, 0, 255, 255]) })
    assert(not s.visible(below))
    assert(s.visible(top))
    var v = s.get(top).unwrap()
    v.opacity = 0.5
    s.set(top, v)
    assert(s.visible(below))
    // Translucent texels, with an opaque region over all of them.
    v = compose.View { tex: solid(mut dev, 16, 16, [0, 0, 255, 128]), opaque: compose.Rect { w: 16.0, h: 16.0 } }
    s.set(top, v)
    assert(not s.visible(below))
    v.x = 8.0
    s.set(top, v)
    assert(s.visible(below))
    // Off screen is not visible.
    s.set(below, compose.View { tex: solid(mut dev, 8, 8, [255, 0, 0, 255]), x: 40.0 })
    assert(not s.visible(below))
}

test "stacking order" {
    guard let Some((d, o, cv)) = setup() else {
        return
    }
    var dev = d
    var out = o
    var c = cv
    var s = compose.Scene.new(32, 32, vec4(0.0, 0.0, 0.0, 1.0))
    let a = s.add(compose.View { tex: solid(mut dev, 32, 32, [255, 0, 0, 255]) })
    let b = s.add(compose.View { tex: solid(mut dev, 32, 32, [0, 0, 255, 255]) })
    let (_, one) = frame(mut dev, mut c, mut s, mut out)
    assert_eq(px(one, 5, 5), blue)
    s.place_above(b, 0)
    let (_, two) = frame(mut dev, mut c, mut s, mut out)
    assert_eq(px(two, 5, 5), red)
    s.place_above(b, a)
    let (_, three) = frame(mut dev, mut c, mut s, mut out)
    assert_eq(px(three, 5, 5), blue)
}

test "a full-screen imported window is offered for scanout" {
    guard let Some((d, o, cv)) = setup() else {
        return
    }
    var dev = d
    guard let Ok((client, buf)) = dev.export_dmabuf(gpu.TextureDesc { width: 32, height: 32 }) else {
        return
    }
    let tex = dev.import_dmabuf(gpu.Dmabuf { opaque: true, ..buf }).unwrap()
    var s = compose.Scene.new(32, 32, vec4(0.0, 0.0, 0.0, 1.0))
    let id = s.add(compose.View { tex })
    assert_eq(s.scanout(), Some(id))
    let cursor = s.add(compose.View { tex: solid(mut dev, 4, 4, [255, 255, 255, 255]) })
    assert_eq(s.scanout(), None)
    s.remove(cursor)
    s.set(id, compose.View { tex, w: 16.0, h: 16.0 })
    assert_eq(s.scanout(), None)
}

test "reorder uses LIS damage and remove_many compacts 1000 views" {
    guard let Ok(d) = gpu.Device.open(gpu.Options { headless: true }) else {
        return
    }
    var dev = d
    var out = gpu.Offscreen.create(mut dev, 128, 128, gpu.Format.R8G8B8A8_UNORM).unwrap()
    var c = draw2d.Canvas.create(mut dev, gpu.Format.R8G8B8A8_UNORM).unwrap()
    let tex = solid(mut dev, 4, 4, [255, 0, 0, 255])
    var s = compose.Scene.new(128, 128, vec4(0.0, 0.0, 0.0, 1.0))
    var ids: List[u32] = []
    for i in 0..1000 {
        let x = f32((i * 7) % 120)
        let y = f32((i * 11) % 120)
        ids.push(s.add(compose.View { tex, x, y, w: 4.0, h: 4.0 }))
    }
    discard frame(mut dev, mut c, mut s, mut out)
    assert(s.idle())

    // No-op reorder must leave the scene idle.
    s.reorder(ids)
    assert(s.idle())

    // Moving only the bottom view to the top must damage only its 4x4 rect.
    var ids2: List[u32] = []
    for i in 1..1000 {
        ids2.push(ids[i])
    }
    ids2.push(ids[0])
    s.reorder(ids2)
    assert(not s.idle())
    discard frame(mut dev, mut c, mut s, mut out)
    assert_eq(s.changed().len(), 1)
    assert_eq(s.changed()[0], compose.Rect { x: 0.0, y: 0.0, w: 4.0, h: 4.0 })

    // Batch remove first 500 views in O(N).
    var rm: List[u32] = []
    for i in 0..500 {
        rm.push(ids[i])
    }
    s.remove_many(rm)
    for i in 0..500 {
        assert(s.get(ids[i]).is_none())
    }
    for i in 500..1000 {
        assert(s.get(ids[i]).is_some())
    }
}

test "overlay candidates respect z-order and exclude overlay from primary" {
    guard let Some((d, o, cv)) = setup() else {
        return
    }
    var dev = d
    var out = o
    var c = cv
    guard let Ok((client, buf)) = dev.export_dmabuf(gpu.TextureDesc { width: 8, height: 8 }) else {
        return
    }
    var e = dev.encoder().unwrap()
    e.render(gpu.Pass { target: client, clear: [0.0, 1.0, 0.0, 1.0] }, fn(mut r) {})
    let (_, fence) = dev.submit_sync_file(take e).unwrap()
    let ov_tex = dev.import_dmabuf(buf).unwrap()
    dev.wait_sync_file(fence).unwrap()

    var s = compose.Scene.new(32, 32, vec4(0.0, 0.0, 0.0, 1.0))
    let ov_id = s.add(compose.View { tex: ov_tex, x: 0.0, y: 0.0, w: 8.0, h: 8.0 })
    assert_eq(s.overlay_candidates(4), [ov_id])

    // An overlapping non-imported view above blocks promotion above primary.
    let top_tex = solid(mut dev, 8, 8, [255, 0, 0, 255])
    let top_id = s.add(compose.View { tex: top_tex, x: 4.0, y: 4.0, w: 8.0, h: 8.0 })
    assert(s.overlay_candidates(4).is_empty())

    // Moving top view away makes the imported view eligible again.
    s.set(top_id, compose.View { tex: top_tex, x: 16.0, y: 16.0, w: 8.0, h: 8.0 })
    assert_eq(s.overlay_candidates(4), [ov_id])

    // Excluding overlay skips drawing it into the primary target.
    s.set_overlays([ov_id])
    let (_, img1) = frame(mut dev, mut c, mut s, mut out)
    assert_eq(px(img1, 2, 2), black)
    assert_eq(px(img1, 18, 18), red)

    // Client commits to the overlay surface leave primary idle.
    s.commit(ov_id, None)
    assert(s.idle())

    // Leaving overlay mode damages and restores primary drawing of the surface.
    let no_ov: List[u32] = []
    s.set_overlays(no_ov)
    let (drew2, img2) = frame(mut dev, mut c, mut s, mut out)
    assert(drew2)
    assert_eq(px(img2, 2, 2), (u8(0), u8(255), u8(0), u8(255)))
}
