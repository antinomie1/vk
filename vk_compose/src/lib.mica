// vk_compose: a compositor's frame. Windows are views over textures (shm
// uploads or imported dmabufs) stacked back to front. The scene turns what
// changed since the last frame into damage (a few rectangles), widens it
// by the target image's age (older images missed the damage of the frames
// since), and redraws only that with vk_draw2d, in one pass, skipping
// whatever an opaque view hides. Imported textures are acquired from and
// released to their clients around the pass.

import std.collections.map
import std.mem
import vk_gpu as gpu
import vk_draw2d as draw2d
pub import region

pub type Rect = draw2d.Rect
pub type Transform = draw2d.Transform
pub type Region = region.Region

pub struct View {
    /// What it shows. A solid color is a 1x1 texture.
    pub tex: gpu.Texture
    pub x: f32 = 0.0
    pub y: f32 = 0.0
    /// Size on screen; 0 means the size of `src`.
    pub w: f32 = 0.0
    pub h: f32 = 0.0
    /// The part shown, in pixels of the upright picture (the texture turned
    /// back by `transform`); empty means all of it (wp_viewport source).
    pub src: Rect = Rect {}
    /// How the texture is turned (wl_surface.set_buffer_transform).
    pub transform: Transform = Transform.Normal
    pub opacity: f32 = 1.0
    pub radius: f32 = 0.0
    /// Drop shadow blur in pixels; 0 for none.
    pub shadow: f32 = 0.0
    /// Where it is opaque, relative to `x, y` in screen pixels
    /// (wl_surface.set_opaque_region); an opaque texture
    /// (`TextureDesc.opaque`, `Dmabuf.opaque`) is opaque everywhere.
    /// Nothing it hides is drawn.
    pub opaque: Rect = Rect {}
}

/// The texture's size turned upright.
fn View.picture(self) -> vec2 {
    let w = f32(self.tex.width())
    let h = f32(self.tex.height())
    return if self.transform.swaps() { vec2(h, w) } else { vec2(w, h) }
}

/// `src` in 0..1 of the picture.
fn View.part(self) -> Rect {
    guard not self.src.is_empty() else {
        return Rect { w: 1.0, h: 1.0 }
    }
    let p = self.picture()
    return Rect { x: self.src.x / p.x, y: self.src.y / p.y, w: self.src.w / p.x, h: self.src.h / p.y }
}

/// Where `v` covers the screen, shadow excluded.
fn View.rect(self) -> Rect {
    let size = if self.src.is_empty() { self.picture() } else { vec2(self.src.w, self.src.h) }
    let w = if self.w > 0.0 { self.w } else { size.x }
    let h = if self.h > 0.0 { self.h } else { size.y }
    return Rect { x: self.x, y: self.y, w, h }
}

fn View.bounds(self) -> Rect {
    return self.rect().grow(self.shadow)
}

/// Where it hides what is under it, in whole pixels.
fn View.cover(self) -> Rect {
    guard self.opacity >= 1.0 else {
        return Rect {}
    }
    let r = self.rect()
    var o = if self.tex.opaque() { r } else { Rect { x: self.x + self.opaque.x, y: self.y + self.opaque.y, w: self.opaque.w, h: self.opaque.h }.intersect(r) }
    if self.radius > 0.0 {
        o = o.intersect(r.grow(-0.293 * self.radius))
    }
    return o.inner()
}

struct Entry {
    id: u32
    view: View
    overlay: bool = false
}

/// Damage of the last frames, newest first: what an image of age a missed.
let history_len = 4

pub struct Scene {
    width: f32
    height: f32
    background: vec4
    entries: List[Entry] = []
    index: map.Map[u32, int]
    next: u32 = 1
    has_overlays: bool = false
    /// Damage since the last `render`.
    pending: Region = Region {}
    /// Never empty: frame 0 changed nothing.
    history: List[Region]
    /// Scratch: what `render` redraws, plus scratch lists for O(N) diff/restack.
    area: Region = Region {}
    scratch_entries: List[Entry] = []
    scratch_pos: List[int] = []
    scratch_tails: List[int] = []
    scratch_tails_idx: List[int] = []
    scratch_prev: List[int] = []
    scratch_keep: List[bool] = []
}

pub fn Scene.new(width: u32, height: u32, background: vec4) -> Scene {
    var s = Scene { width: f32(width), height: f32(height), background, index: map.Map.new(), history: [Region {}] }
    s.damage_all()
    return s
}

fn Scene.screen(self) -> Rect {
    return Rect { w: self.width, h: self.height }
}

/// Redraw `r` (screen pixels) next frame.
pub fn Scene.damage(mut self, r: Rect) {
    self.pending.add(r.intersect(self.screen()))
}

pub fn Scene.damage_all(mut self) {
    self.damage(self.screen())
}

fn Scene.find(self, id: u32) -> int {
    return self.index.get(id).unwrap_or(-1)
}

/// Put `v` on top; its id names it from now on.
pub fn Scene.add(mut self, v: View) -> u32 {
    let id = self.next
    self.next += 1
    let at = self.entries.len()
    self.entries.push(Entry { id, view: v })
    discard self.index.insert(id, at)
    self.damage(v.bounds())
    return id
}

/// Move, resize, restyle or give `id` a new texture. A new texture alone
/// (same size, place and style) damages nothing: say what the client drew
/// with `commit`.
pub fn Scene.set(mut self, id: u32, v: View) {
    let i = self.find(id)
    guard i >= 0 else {
        return
    }
    let e = self.entries[i]
    let old = e.view
    self.entries[i] = Entry { id, view: v, overlay: e.overlay }
    let same = View { tex: old.tex, ..v } == old and v.rect() == old.rect() and v.tex.opaque() == old.tex.opaque()
    if not same {
        self.damage(old.bounds())
        self.damage(v.bounds())
    }
}

pub fn Scene.get(self, id: u32) -> Option[View] {
    let i = self.find(id)
    return if i < 0 { None } else { Some(self.entries[i].view) }
}

/// The client drew into `id`'s texture: `area` in texture pixels, or all.
pub fn Scene.commit(mut self, id: u32, area: Option[Rect]) {
    let i = self.find(id)
    guard i >= 0 else {
        return
    }
    if self.entries[i].overlay {
        return
    }
    let v = self.entries[i].view
    let r = v.rect()
    guard let Some(a) = area else {
        self.damage(r)
        return
    }
    // Texture pixels to 0..1 of the view, through the transform and crop.
    let m = draw2d.transform.uv_map(v.part(), v.transform)
    let tw = f32(v.tex.width())
    let th = f32(v.tex.height())
    let p = m.invert(vec2(a.x / tw, a.y / th))
    let q = m.invert(vec2((a.x + a.w) / tw, (a.y + a.h) / th))
    let x0 = min(p.x, q.x)
    let y0 = min(p.y, q.y)
    let d = Rect { x: r.x + x0 * r.w, y: r.y + y0 * r.h, w: (max(p.x, q.x) - x0) * r.w, h: (max(p.y, q.y) - y0) * r.h }
    // Filtering reads a texel past the edge when scaled.
    self.damage(d.grow(1.0).intersect(r))
}

pub fn Scene.remove(mut self, id: u32) {
    let i = self.find(id)
    guard i >= 0 else {
        return
    }
    self.damage(self.entries[i].view.bounds())
    discard self.entries.remove(i)
    discard self.index.remove(id)
    for k in i..self.entries.len() {
        discard self.index.insert(self.entries[k].id, k)
    }
}

/// Remove a batch of ids in one O(N) compaction pass.
pub fn Scene.remove_many(mut self, ids: &[u32]) {
    guard not ids.is_empty() and not self.entries.is_empty() else {
        return
    }
    let n = self.entries.len()
    var keep = mem.replace(mut self.scratch_keep, [])
    keep.clear()
    for _ in 0..n {
        keep.push(true)
    }
    for id in ids {
        let idx = self.find(id)
        if idx >= 0 and keep[idx] {
            keep[idx] = false
            self.damage(self.entries[idx].view.bounds())
            discard self.index.remove(id)
        }
    }
    var out = mem.replace(mut self.scratch_entries, [])
    out.clear()
    for i in 0..n {
        let e = self.entries[i]
        if keep[i] {
            let pos = out.len()
            out.push(e)
            discard self.index.insert(e.id, pos)
        }
    }
    var old = mem.replace(mut self.entries, out)
    old.clear()
    self.scratch_entries = old
    self.scratch_keep = keep
}

/// Move `id` to the top.
pub fn Scene.raise(mut self, id: u32) {
    let i = self.find(id)
    guard i >= 0 else {
        return
    }
    let e = self.entries.remove(i)
    self.damage(e.view.bounds())
    self.entries.push(e)
    for k in i..self.entries.len() {
        discard self.index.insert(self.entries[k].id, k)
    }
}

/// Move `id` right above `other`, or to the bottom when `other` is 0
/// (subsurfaces, popups).
pub fn Scene.place_above(mut self, id: u32, other: u32) {
    let i = self.find(id)
    guard i >= 0 and id != other else {
        return
    }
    var at = 0
    if other != 0 {
        let k = self.find(other)
        at = if k < 0 { self.entries.len() - 1 } else if k > i { k } else { k + 1 }
    }
    let e = self.entries.remove(i)
    self.damage(e.view.bounds())
    self.entries.insert(at, e)
    let lo = min(i, at)
    let hi = min(max(i, at) + 1, self.entries.len())
    for k in lo..hi {
        discard self.index.insert(self.entries[k].id, k)
    }
}

/// Reorder views to `order` (back to front) in O(N log N) time using the
/// longest increasing subsequence to minimize damage, or O(N) with zero
/// damage/allocations when the order did not change.
pub fn Scene.reorder(mut self, order: &[u32]) {
    let n = self.entries.len()
    guard n > 1 else {
        return
    }
    if order.len() == n {
        var same = true
        for k in 0..n {
            if self.entries[k].id != order[k] {
                same = false
                break
            }
        }
        if same {
            return
        }
    }
    var seen = mem.replace(mut self.scratch_keep, [])
    seen.clear()
    for _ in 0..n {
        seen.push(false)
    }
    var pos = mem.replace(mut self.scratch_pos, [])
    pos.clear()
    for id in order {
        let idx = self.find(id)
        if idx >= 0 and not seen[idx] {
            seen[idx] = true
            pos.push(idx)
        }
    }
    for i in 0..n {
        if not seen[i] {
            pos.push(i)
        }
    }
    let m = pos.len()
    var tails = mem.replace(mut self.scratch_tails, [])
    var tails_idx = mem.replace(mut self.scratch_tails_idx, [])
    var prev = mem.replace(mut self.scratch_prev, [])
    tails.clear()
    tails_idx.clear()
    prev.clear()
    for k in 0..m {
        let v = pos[k]
        var lo = 0
        var hi = tails.len()
        while lo < hi {
            let mid = lo + (hi - lo) / 2
            if tails[mid] < v {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        prev.push(if lo > 0 { tails_idx[lo - 1] } else { -1 })
        if lo == tails.len() {
            tails.push(v)
            tails_idx.push(k)
        } else {
            tails[lo] = v
            tails_idx[lo] = k
        }
        seen[k] = false
    }
    if not tails_idx.is_empty() {
        var cur = tails_idx[tails_idx.len() - 1]
        while cur >= 0 {
            seen[cur] = true
            cur = prev[cur]
        }
    }
    var out = mem.replace(mut self.scratch_entries, [])
    out.clear()
    for k in 0..m {
        let e = self.entries[pos[k]]
        if not seen[k] {
            self.damage(e.view.bounds())
        }
        let ni = out.len()
        out.push(e)
        discard self.index.insert(e.id, ni)
    }
    var old = mem.replace(mut self.entries, out)
    old.clear()
    self.scratch_entries = old
    self.scratch_pos = pos
    self.scratch_tails = tails
    self.scratch_tails_idx = tails_idx
    self.scratch_prev = prev
    self.scratch_keep = seen
}

pub fn Scene.resize(mut self, width: u32, height: u32) {
    self.width = f32(width)
    self.height = f32(height)
    self.damage_all()
}

/// Nothing changed since the last frame: no need to draw or present.
pub fn Scene.idle(self) -> bool {
    return self.pending.is_empty()
}

/// Whether any of `id` shows: on screen and not hidden by an opaque view
/// above it. Hidden clients can skip frames (no frame callbacks).
pub fn Scene.visible(self, id: u32) -> bool {
    let i = self.find(id)
    guard i >= 0 else {
        return false
    }
    let b = self.entries[i].view.bounds().intersect(self.screen())
    guard not b.is_empty() else {
        return false
    }
    for k in i + 1..self.entries.len() {
        if self.entries[k].view.cover().contains(b) {
            return false
        }
    }
    return true
}

/// The view that alone fills the screen as it is (opaque, unscaled,
/// unturned, uncropped, imported, on top): show its buffer directly (a KMS
/// plane, a parent compositor's surface) instead of rendering.
pub fn Scene.scanout(self) -> Option[u32] {
    guard let Some(e) = self.entries.last() else {
        return None
    }
    let v = e.view
    let screen = self.screen()
    let plain = v.transform == Transform.Normal and v.src.is_empty() and v.radius <= 0.0
    let fits = v.rect() == screen and f32(v.tex.width()) == self.width and f32(v.tex.height()) == self.height
    return if plain and fits and v.tex.imported() and v.cover().contains(screen) { Some(e.id) } else { None }
}

/// Up to `max_count` views eligible for hardware overlay planes above the
/// primary plane (top to bottom), skipping anything occluded by higher
/// primary-plane content.
pub fn Scene.overlay_candidates(self, max_count: int) -> List[u32] {
    var out: List[u32] = []
    guard max_count > 0 else {
        return out
    }
    let screen = self.screen()
    var blocked: List[Rect] = []
    var i = self.entries.len() - 1
    while i >= 0 {
        let e = self.entries[i]
        let v = e.view
        let r = v.rect()
        let integer = r.x == r.x.floor() and r.y == r.y.floor() and r.w == r.w.floor() and r.h == r.h.floor()
        let eligible = v.tex.imported() and v.transform == Transform.Normal and v.opacity >= 1.0 and v.radius <= 0.0 and v.shadow <= 0.0 and integer and screen.contains(r)
        var hidden = false
        if eligible {
            let b = v.bounds()
            for br in blocked {
                if br.overlaps(b) {
                    hidden = true
                    break
                }
            }
        }
        if eligible and not hidden and out.len() < max_count {
            out.push(e.id)
        } else {
            let b = v.bounds().intersect(screen)
            if not b.is_empty() {
                blocked.push(b)
            }
        }
        i -= 1
    }
    return out
}

/// Mark `ids` as hardware-promoted overlays (excluded from primary GPU
/// composition); damages the primary plane on entry/exit transitions.
pub fn Scene.set_overlays(mut self, ids: &[u32]) {
    if ids.is_empty() and not self.has_overlays {
        return
    }
    let n = self.entries.len()
    var next_ov = mem.replace(mut self.scratch_keep, [])
    next_ov.clear()
    for _ in 0..n {
        next_ov.push(false)
    }
    for id in ids {
        let idx = self.find(id)
        if idx >= 0 {
            next_ov[idx] = true
        }
    }
    var any = false
    for i in 0..n {
        let want = next_ov[i]
        if want {
            any = true
        }
        if self.entries[i].overlay != want {
            self.entries[i].overlay = want
            self.damage(self.entries[i].view.bounds())
        }
    }
    self.has_overlays = any
    self.scratch_keep = next_ov
}

/// What the last `render` changed on screen against the frame before it:
/// KMS FB_DAMAGE_CLIPS, or damage for a parent compositor.
pub fn Scene.changed(self) -> &[Rect] {
    return self.history[0].rects()
}

/// Redraw what frame `f` needs into it, recording into `e`; false when
/// its image is already up to date. Present `e` either way.
pub fn Scene.render(mut self, mut dev: gpu.Device, mut c: draw2d.Canvas, mut e: gpu.Encoder, f: gpu.Frame) -> Result[bool, str] {
    let screen = self.screen()
    let age = int(f.age())
    var area = mem.replace(mut self.area, Region {})
    area.clear()
    if age == 0 or age > self.history.len() + 1 {
        area.add(screen)
    } else {
        area.add_region(self.pending)
        for i in 0..age - 1 {
            area.add_region(self.history[i])
        }
    }
    var now = if self.history.len() >= history_len { self.history.pop().unwrap() } else { Region {} }
    now.clear()
    now.add_region(self.pending)
    self.history.insert(0, now)
    self.pending.clear()
    let drew = not area.is_empty()
    if drew {
        try self.draw(mut dev, mut c, mut e, f, area)
    }
    self.area = area
    return Ok(drew)
}

fn Scene.draw(self, mut dev: gpu.Device, mut c: draw2d.Canvas, mut e: gpu.Encoder, f: gpu.Frame, area: Region) -> Result[(), str] {
    c.clear()
    c.rect(self.screen(), self.background)
    for en in self.entries {
        if en.overlay {
            continue
        }
        let v = en.view
        guard area.overlaps(v.bounds()) else {
            continue
        }
        if v.shadow > 0.0 {
            c.shadow(v.rect(), vec4(0.0, 0.0, 0.0, 0.45 * v.opacity), v.radius, v.shadow)
        }
        c.texture(v.tex, v.rect(), v.part(), v.transform, vec4(1.0, 1.0, 1.0, v.opacity), v.radius)
        c.opaque(v.cover())
        e.acquire(v.tex)
    }
    try c.draw(mut dev, mut e, gpu.Pass { target: f.image(), load: gpu.Load.Keep }, area.rects())
    for en in self.entries {
        if not en.overlay and area.overlaps(en.view.bounds()) {
            e.release(en.view.tex)
        }
    }
    return Ok(())
}
